(ns itonami.agent.provider
  "OpenAI-compatible chat completions with the Hermes provider chain.

  Resolution follows Hermes (cron/scheduler.py, hermes_cli/runtime_provider_custom.py):
    model    : job pin -> cron.model -> model.default
    provider : job pin -> cron.model_provider -> model.provider
    chain    : [primary] ++ fallback_providers, unless the job pinned a model
  A provider name resolves through config `providers.<name>` first, then the
  built-in rails below. Every hop that fails (transport, non-2xx, an `error`
  body, no choices) moves to the next; the last error is returned by name."
  (:require [clojure.string :as str]
            [promesa.core :as p]
            [itonami.agent.host :as h]))

(def built-in
  {"kotoba"     {"base_url" "https://api.kotoba.cloud/v1"   "key_env" "KOTOBA_API_TOKEN"}
   "murakumo"   {"base_url" "https://api.murakumo.cloud/v1" "key_env" "MURAKUMO_API_TOKEN"}
   "openrouter" {"base_url" "https://openrouter.ai/api/v1"  "key_env" "OPENROUTER_API_KEY"}
   "nous"       {"base_url" "https://inference-api.nousresearch.com/v1" "key_env" "NOUS_API_KEY"}
   "openai"     {"base_url" "https://api.openai.com/v1"     "key_env" "OPENAI_API_KEY"}
   ;; this node's own peer server: own rails, then trusted peers' rails
   "itonami-p2p" {"base_url" "http://127.0.0.1:7420/v1"}})

(def default-headers
  {"HTTP-Referer" "https://itonami.cloud"
   "X-Title" "Itonami By KotobaLabs"})

(defn resolve-hop
  "One {provider model base_url key_env} entry -> a callable hop."
  [config {:strs [provider model base_url key_env]}]
  (let [pc (get-in config ["providers" provider])
        bi (get built-in provider)
        base (or base_url (get pc "base_url") (get bi "base_url")
                 (when (= provider (get-in config ["model" "provider"])) (get-in config ["model" "base_url"])))
        mc (get-in pc ["models" model])]
    {:provider provider
     :model model
     :base-url (some-> base (str/replace #"/+$" ""))
     :key-env (or key_env (get pc "key_env") (get pc "api_key_env") (get bi "key_env"))
     :headers (merge default-headers (get pc "extra_headers"))
     :extra-body (get pc "extra_body")
     :timeout-s (or (get mc "timeout_seconds") (get pc "request_timeout_seconds") 900)}))

(defn chain
  "The ordered hops for a run. opts: {:model :provider :pinned?} from a job or
  the CLI (-m / --provider)."
  [config {:keys [model provider pinned?]}]
  (let [m (or model (get-in config ["cron" "model"]) (get-in config ["model" "default"]))
        pv (or provider (get-in config ["cron" "model_provider"]) (get-in config ["model" "provider"]))
        primary (resolve-hop config {"provider" pv "model" m
                                     "base_url" (when (= pv (get-in config ["model" "provider"]))
                                                  (get-in config ["model" "base_url"]))})
        fb (let [f (get config "fallback_providers")
                 legacy (get config "fallback_model")]
             (cond (sequential? f) f (map? legacy) [legacy] :else []))
        fb (for [e fb :when (and (get e "provider") (get e "model"))] (resolve-hop config e))]
    (vec (distinct (if pinned? [primary] (cons primary fb))))))

(def default-deny-hosts
  "Third-party relays an itonami profile does not depend on. A rail must be
  owned by a node (its own server, its mesh, a trusted peer) or be one of the
  operator's few authority servers."
  ["openrouter.ai"])

(def default-authorities
  "The few authority servers the decentralised plane may use while they are
  healthy — never depend on: each sits behind a circuit breaker, and the
  chain always also carries the itonami-p2p rail."
  ["api.kotoba.cloud" "api.murakumo.cloud"])

(def p2p-hop {"provider" "itonami-p2p" "model" "auto"})

(defn authority-host [hop authorities]
  (some #(when (str/includes? (str (:base-url hop)) %) %) authorities))

(defn decentralize
  "For an itonami profile (manifest present): drop relay hops
  (:inference :deny-hosts), mark authority hops (:inference :authorities) so
  `complete` guards them with the breaker, and make sure the itonami-p2p rail
  is on the chain so it never consists of authorities alone. A profile
  without itonami.edn keeps its Hermes chain unchanged."
  ([hops manifest] (decentralize hops manifest nil))
  ([hops manifest config]
   (if-not manifest
     hops
     (let [deny (get-in manifest [:inference :deny-hosts] default-deny-hosts)
           auth (get-in manifest [:inference :authorities] default-authorities)
           kept (vec (remove (fn [hop] (some #(str/includes? (str (:base-url hop)) %) deny)) hops))
           kept (mapv #(if-let [a (authority-host % auth)] (assoc % :authority a) %) kept)
           kept (if (some #(= "itonami-p2p" (:provider %)) kept)
                  kept
                  (conj kept (resolve-hop (or config {}) p2p-hop)))]
       kept))))

;; ---------------------------------------------------------------- authority circuit breaker

(defn- health-file [] (h/join (h/expand (or (h/env "ITONAMI_DIR") "~/.itonami")) "authority-health.json"))

(defn read-health []
  (let [f (health-file)] (if (h/file? f) (try (h/json-parse (h/slurp f)) (catch :default _ {})) {})))

(defn- write-health! [m] (h/spit-atomic (health-file) (h/json-str m 2)))

(defn breaker-open? [host]
  (when-let [{:strs [down_until]} (get (read-health) host)]
    (> down_until (h/now-ms))))

(defn cooldown-ms
  "How long an authority is skipped after a failure of this kind."
  [{:keys [status error]}]
  (cond
    (= 402 status) (* 30 60000)                    ; out of credit: not coming back in minutes
    (#{401 403} status) (* 30 60000)               ; credentials refused
    (= 429 status) (* 2 60000)                     ; busy
    :else (* 5 60000)))                            ; 5xx, transport, empty

(defn record-authority! [host err]
  (let [m (read-health)]
    (write-health! (if err
                     (assoc m host {"down_until" (+ (h/now-ms) (cooldown-ms err)) "status" (:status err)
                                    "reason" (subs (str (:error err)) 0 (min 160 (count (str (:error err)))))
                                    "since" (h/iso-local)})
                     (dissoc m host)))))

(defn- fetch-json
  [url {:keys [headers body timeout-s]}]
  (let [ctrl (js/AbortController.)
        t (js/setTimeout #(.abort ctrl) (* 1000 timeout-s))]
    (-> (js/fetch url (clj->js {:method "POST" :headers headers :body body :signal (.-signal ctrl)}))
        (p/then (fn [^js r] (p/let [txt (.text r)] {:status (.-status r) :text txt})))
        (p/finally (fn [] (js/clearTimeout t))))))

(defn- hop-error [hop status msg]
  {:provider (:provider hop) :model (:model hop) :status status :error (subs (str msg) 0 (min 400 (count (str msg))))})

(defn complete-hop
  "One hop. Resolves to {:ok resp-map} or {:err {...}}."
  [hop env {:keys [messages tools reasoning-effort max-tokens]}]
  (if-not (:base-url hop)
    (p/resolved {:err (hop-error hop nil "no base_url for provider")})
    (let [key (when (:key-env hop) (get env (:key-env hop)))
          headers (cond-> (merge {"Content-Type" "application/json"} (:headers hop))
                    true (assoc "Authorization" (str "Bearer " (or key "no-key-required"))))
          body (cond-> (merge (:extra-body hop) {"model" (:model hop) "messages" messages})
                 (seq tools) (assoc "tools" tools)
                 reasoning-effort (assoc "reasoning_effort" reasoning-effort)
                 max-tokens (assoc "max_tokens" max-tokens))]
      (-> (fetch-json (str (:base-url hop) "/chat/completions")
                      {:headers headers :body (h/json-str body) :timeout-s (:timeout-s hop)})
          (p/then (fn [{:keys [status text]}]
                    (let [j (try (h/json-parse text) (catch :default _ nil))
                          choice (first (get j "choices"))
                          msg (get choice "message")]
                      (cond
                        (not (<= 200 status 299)) {:err (hop-error hop status (or (get-in j ["error" "message"]) (get j "error") text))}
                        (get j "error") {:err (hop-error hop status (or (get-in j ["error" "message"]) (get j "error")))}
                        (nil? msg) {:err (hop-error hop status (str "no choices: " (subs text 0 (min 200 (count text)))))}
                        (and (str/blank? (get msg "content")) (empty? (get msg "tool_calls")))
                        {:err (hop-error hop status "empty response")}
                        :else {:ok {:message msg
                                    :finish-reason (get choice "finish_reason")
                                    :usage (get j "usage")
                                    :model (or (get j "model") (:model hop))
                                    :provider (:provider hop)}}))))
          (p/catch (fn [e] {:err (hop-error hop nil (str "transport: " (.-message e)))}))))))

(defn- retryable? [{:keys [status error]}]
  (or (nil? status) (= 429 status) (<= 500 status 599)
      (re-find #"(?i)busy|capacity|timeout|aborted|transport|skipped" (str error))))

(defn- complete-round
  [hops env {:keys [deadline-ms on-hop] :as req} attempts]
  (p/loop [[hop & more] hops attempts attempts]
    (if (nil? hop)
      {:err (or (last attempts) {:error "no provider configured"}) :attempts attempts}
      (if (and (:authority hop) (breaker-open? (:authority hop)))
        ;; authority known to be down: skip at no cost, the decentralised rails carry the turn
        (p/recur more (conj attempts {:provider (:provider hop) :model (:model hop) :status nil
                                      :error (str "skipped: authority " (:authority hop) " breaker open")}))
      (p/let [;; share the time left fairly among the hops still to try, so one
              ;; slow rail cannot starve the fallbacks behind it
              hop (if deadline-ms
                    (update hop :timeout-s #(min % (max 60 (js/Math.floor (/ (- deadline-ms (h/now-ms))
                                                                            (* 1000 (inc (count more))))))))
                    hop)
              t0 (h/now-ms)
              r (complete-hop hop env req)
              _ (when on-hop (on-hop hop r (- (h/now-ms) t0)))
              _ (when (:authority hop) (record-authority! (:authority hop) (:err r)))]
        (if (:ok r)
          (assoc r :attempts attempts)
          (p/recur more (conj attempts (:err r)))))))))

(defn complete
  "Walk the chain. Resolves to {:ok resp :attempts [...]} or {:err last :attempts [...]}.
  req may carry :deadline-ms (epoch ms): each hop's timeout is capped at the
  time left divided by the hops still to try in the round (min 60 s).
  When every hop of a round failed with a transient error (429 / 5xx /
  transport), wait and walk the chain again — up to :rounds (default 3) and
  only while the deadline leaves room — instead of failing the turn on a
  momentarily saturated fleet. :on-hop (fn [hop result-or-nil ms]) observes
  each hop."
  [hops env {:keys [deadline-ms rounds] :or {rounds 3} :as req}]
  (p/loop [round 1 attempts []]
    (p/let [r (complete-round hops env req attempts)]
      (let [round-errs (take-last (count hops) (:attempts r))
            wait-ms (* 15000 round)]
        (if (and (:err r) (< round rounds)
                 (every? retryable? round-errs)
                 (or (nil? deadline-ms) (> (- deadline-ms (h/now-ms)) (+ wait-ms 120000))))
          (p/let [_ (p/delay wait-ms)] (p/recur (inc round) (:attempts r)))
          r)))))
