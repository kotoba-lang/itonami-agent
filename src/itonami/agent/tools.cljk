(ns itonami.agent.tools
  "The Hermes core tools, same names and argument shapes (tools/*.py), so a
  SOUL or skill written for Hermes calls them unchanged.

  Toolsets mirror Hermes: terminal / file / web / skills / todo / cron / memory.
  Results are JSON strings, as Hermes returns them.

  `ctx` carries where a tool may act:
    {:cwd dir  :home profile-home  :roots [dirs writes may touch] | nil
     :writes (atom [])  :timeout-ms n  :terminal-policy (confine/policy ...)}
  :roots nil means unrestricted (local runs, like Hermes' local backend).
  A peer run always sets :roots to the bundle's materialized home, so a turn
  run on someone else's machine cannot write outside the copy it was given."
  (:require [clojure.string :as str]
            [promesa.core :as p]
            [itonami.agent.host :as h]
            [itonami.agent.confine :as confine]
            [itonami.agent.webguard :as webguard]
            [itonami.agent.process :as process]
            [itonami.agent.homeassistant :as homeassistant]
            [itonami.agent.profile :as profile]
            [itonami.agent.provider :as provider]
            [itonami.agent.browser :as browser]
            [itonami.agent.computer-use :as computer-use]
            [itonami.agent.yaml :as yaml]
            ["node:crypto" :as crypto]
            ["node:sqlite" :as sqlite]))

(defn- fn-schema [name desc props required]
  {"type" "function"
   "function" {"name" name "description" desc
               "parameters" {"type" "object" "properties" props "required" required}}})

(def schemas
  {"terminal"
   (fn-schema "terminal" "Execute a shell command on the host and return its output. Use for running scripts, git, builds and inspecting the system."
              {"command" {"type" "string" "description" "The command to execute"}
               "timeout" {"type" "integer" "description" "Seconds before the command is killed (default 180)"}
               "workdir" {"type" "string" "description" "Working directory (default: the profile's terminal cwd)"}
               "background" {"type" "boolean" "description" "Start a background process; use process_manage to poll, wait, read output, send stdin, or terminate it"}}
              ["command"])
   "process_manage"
   (fn-schema "process_manage" "Poll, wait on, read, or control a background terminal process started in this Kotoba agent runtime. Completed results are retained for up to 7 days, newest 64 per profile, while the agent runtime is alive."
              {"action" {"type" "string" "enum" ["list" "poll" "log" "wait" "kill" "write" "submit" "close" "handoff"]}
               "session_id" {"type" "string" "description" "Exact id or unique prefix returned by terminal(background=true). Required except for list."}
               "data" {"type" "string" "description" "Text to write or submit to stdin."}
               "timeout" {"type" "integer" "minimum" 1 "description" "Seconds to wait, capped at 1800."}
               "offset" {"type" "integer" "description" "Zero-based log line offset; omitted reads the tail."}
               "limit" {"type" "integer" "minimum" 1 "description" "Maximum log lines (capped at 2000)."}}
              ["action"])
   "read_file"
   (fn-schema "read_file" "Read a text file with line numbers (LINE_NUM|CONTENT)."
              {"path" {"type" "string"} "offset" {"type" "integer" "description" "1-based first line"}
               "limit" {"type" "integer" "description" "max lines (<= 2000)"}}
              ["path"])
   "write_file"
   (fn-schema "write_file" "Write content to a file, creating parent directories. Overwrites."
              {"path" {"type" "string"} "content" {"type" "string"}}
              ["path" "content"])
   "patch"
   (fn-schema "patch" "Replace old_string with new_string in a file. old_string must be unique unless replace_all."
              {"path" {"type" "string"} "old_string" {"type" "string"} "new_string" {"type" "string"}
               "replace_all" {"type" "boolean"}}
              ["path" "old_string" "new_string"])
   "search_files"
   (fn-schema "search_files" "Search file contents (regex) or file names (glob) under a path."
              {"pattern" {"type" "string"} "target" {"type" "string" "enum" ["content" "files"]}
               "path" {"type" "string"} "file_glob" {"type" "string"} "limit" {"type" "integer"}}
              ["pattern"])
   "web_search"
   (fn-schema "web_search" "Search the web. Returns titles, urls and snippets."
              {"query" {"type" "string"} "limit" {"type" "integer"}}
              ["query"])
   "web_extract"
   (fn-schema "web_extract" "Fetch up to 5 URLs and return their readable text."
              {"urls" {"type" "array" "items" {"type" "string"}} "char_limit" {"type" "integer"}}
              ["urls"])
   "browser_navigate"
   (fn-schema "browser_navigate" "Navigate to a public website through Kotoba's guarded browser proxy."
              {"url" {"type" "string"}} ["url"])
   "browser_snapshot"
   (fn-schema "browser_snapshot" "Read the current page accessibility snapshot."
              {"full" {"type" "boolean" "default" false}} [])
   "browser_click"
   (fn-schema "browser_click" "Click an element ref from the latest browser snapshot."
              {"ref" {"type" "string"}} ["ref"])
   "browser_type"
   (fn-schema "browser_type" "Replace the value of an input identified by a browser ref."
              {"ref" {"type" "string"} "text" {"type" "string"}} ["ref" "text"])
   "browser_scroll"
   (fn-schema "browser_scroll" "Scroll the current browser page."
              {"direction" {"type" "string" "enum" ["up" "down" "left" "right"]}} ["direction"])
   "browser_back"
   (fn-schema "browser_back" "Navigate back in the current browser session." {} [])
   "browser_press"
   (fn-schema "browser_press" "Press a keyboard key in the current browser page."
              {"key" {"type" "string"}} ["key"])
   "browser_get_images"
   (fn-schema "browser_get_images" "List images in the current browser page with source URLs and alt text." {} [])
   "browser_console"
   (fn-schema "browser_console" "Read browser console output or evaluate an expression in the current page."
              {"clear" {"type" "boolean" "default" false} "expression" {"type" "string"}} [])
   "browser_vision"
   (fn-schema "browser_vision" "Capture the current page and analyze its visible layout with the active Kotoba vision provider."
              {"question" {"type" "string"} "annotate" {"type" "boolean" "default" false}} ["question"])
   "vision_analyze"
   (fn-schema "vision_analyze" "Analyze an image using the active Kotoba provider chain. Remote URLs use the public-only web guard; local files must be readable by this run."
              {"image_url" {"type" "string" "description" "Public http(s) image URL, base64 image data URL, or readable local image path."}
               "question" {"type" "string" "description" "What to inspect or answer about the image."}}
              ["image_url" "question"])
   "skill_view"
   (fn-schema "skill_view" "Read a skill's SKILL.md (or a file inside the skill)."
              {"name" {"type" "string"} "file_path" {"type" "string"}}
              ["name"])
   "skills_list"
   (fn-schema "skills_list" "List available profile skills with names, descriptions, and categories. Use skill_view(name) to load a skill."
              {"category" {"type" "string" "description" "Optional category filter"}}
              [])
   "skill_manage"
   (fn-schema "skill_manage" "Create, patch, or delete profile skills and supporting files. Up to 20 operations apply as one approved transaction; any failure rolls the touched skills back. Delete must be the only operation. Read first with skill_view."
              {"operations" {"type" "array" "minItems" 1 "maxItems" 20
                             "items" {"type" "object" "properties"
                                      {"action" {"type" "string" "enum" ["create" "patch" "write_file" "remove_file" "delete"]}
                                       "name" {"type" "string"}
                                       "category" {"type" "string"}
                                       "content" {"type" "string"}
                                       "old_string" {"type" "string"}
                                       "new_string" {"type" "string"}
                                       "replace_all" {"type" "boolean"}
                                       "file_path" {"type" "string"}
                                       "file_content" {"type" "string"}}
                                      "required" ["action" "name"]}}}
              ["operations"])
   "todo_list"
   (fn-schema "todo_list" "Track a task list for multi-step work. Pass todos to replace or merge the list; omit todos to read it. Always returns the full list."
              {"todos" {"type" "array" "items" {"type" "object" "properties"
                                                    {"id" {"type" "string"}
                                                     "content" {"type" "string"}
                                                     "status" {"type" "string" "enum" ["pending" "in_progress" "completed" "cancelled"]}
                                                     "parent" {"type" "string"}}
                                                    "required" ["id" "content" "status"]}}
               "merge" {"type" "boolean" "default" false
                        "description" "Update existing items by id and append new ones instead of replacing the list."}}
              [])
   "delegate_task"
   (fn-schema "delegate_task" "Run up to three independent Kotoba child tasks in parallel and return their summaries. Each task needs a goal and may include context. Children share this profile's tools except delegation, memory, and cron management."
              {"tasks" {"type" "array" "minItems" 1 "maxItems" 3
                        "items" {"type" "object" "properties"
                                 {"goal" {"type" "string"} "context" {"type" "string"}}
                                 "required" ["goal"]}}}
              ["tasks"])
   "cronjob_manage"
   (fn-schema "cronjob_manage" "Manage this profile's scheduled Kotoba jobs, including monitor_script and monitor_url pre-run checks. List, create, update, pause, resume, remove, or run a job. Mutations require approval."
              {"action" {"type" "string" "enum" ["create" "list" "update" "pause" "resume" "remove" "run"]}
               "job_id" {"type" "string"}
               "prompt" {"type" "string"}
               "schedule" {"type" "string" "description" "Use a duration such as 30m or every 2 hours, a phrase such as every weekday at 9am, a 5-field cron expression, an ISO timestamp, or a one-shot such as in 30m."}
               "name" {"type" "string"}
               "repeat" {"type" "integer"} "deliver" {"type" "string"} "failure_deliver" {"type" "string"}
               "script" {"type" "string"} "monitor_script" {"type" "string"} "monitor_url" {"type" "string"}
               "context_from" {"type" "array" "items" {"type" "string"}}
               "continuity" {"type" "boolean"} "enabled_toolsets" {"type" "array" "items" {"type" "string"}}
               "workdir" {"type" "string"} "no_agent" {"type" "boolean"}
               "paused" {"type" "boolean"} "paused_reason" {"type" "string"} "pinned" {"type" "boolean"}
               "skills" {"type" "array" "items" {"type" "string"}} "skill" {"type" "string"}
               "include_disabled" {"type" "boolean"}}
              ["action"])
   "memory"
   (fn-schema "memory" "Add, replace or remove an entry in persistent memory (MEMORY.md / USER.md)."
              {"action" {"type" "string" "enum" ["add" "replace" "remove"]}
               "target" {"type" "string" "enum" ["memory" "user"]}
               "content" {"type" "string"} "old_text" {"type" "string"} "new_text" {"type" "string"}}
              ["action"])
   "execute_code"
   (fn-schema "execute_code" "Run one Python script through this profile's OS confinement. This Kotoba implementation is stateless and does not provide Hermes tool RPC inside the script; use the normal Kotoba tools for tool calls."
              {"code" {"type" "string" "description" "Python source to execute on stdin."}
               "timeout" {"type" "integer" "minimum" 1 "maximum" 300 "description" "Maximum runtime in seconds (default 300)."}}
              ["code"])
   "session_search"
   (fn-schema "session_search" "Search and read this profile's local Hermes conversation history. Supports recent-session browsing, FTS discovery, reading the latest messages in a session, and scrolling around a message id. It is read-only and never searches another profile."
              {"query" {"type" "string" "description" "Full-text search query; omit to browse recent sessions."}
               "limit" {"type" "integer" "minimum" 1 "maximum" 20 "description" "Maximum sessions or matching messages (default 5)."}
               "session_id" {"type" "string" "description" "Read one session from this profile's history."}
               "around_message_id" {"type" "integer" "description" "Return a bounded window around this message id; requires session_id."}
               "window" {"type" "integer" "minimum" 1 "maximum" 20 "description" "Messages on each side of the anchor (default 5)."}
               "role_filter" {"type" "string" "enum" ["user,assistant" "user,assistant,tool" "user" "assistant" "tool"]}}
              [])
   "kanban_show"
   (fn-schema "kanban_show" "Read a Hermes Kanban task with its parent/child links, comments, recent events, and runs."
              {"task_id" {"type" "string" "description" "Kanban task id; defaults to the assigned task in a dispatcher worker."}
               "board" {"type" "string" "description" "Optional Kanban board slug."}}
              [])
   "kanban_list"
   (fn-schema "kanban_list" "List bounded Kanban task summaries for board routing. Dispatcher task workers cannot use this board-wide tool."
              {"assignee" {"type" "string"} "status" {"type" "string"}
               "tenant" {"type" "string"} "include_archived" {"type" "boolean"}
               "limit" {"type" "integer" "minimum" 1 "maximum" 200}
               "board" {"type" "string" "description" "Optional Kanban board slug."}}
              [])
   "kanban_heartbeat"
   (fn-schema "kanban_heartbeat" "Record progress on a running Kanban task and extend this worker's matching claim when available."
              {"task_id" {"type" "string" "description" "Kanban task id; defaults to the assigned task in a dispatcher worker."}
               "note" {"type" "string" "description" "Optional short progress note."}
               "board" {"type" "string" "description" "Optional Kanban board slug."}}
              [])
   "kanban_complete"
   (fn-schema "kanban_complete" "Complete a Kanban task with a structured handoff. A dispatcher worker may complete only its assigned task and matching run."
              {"task_id" {"type" "string" "description" "Kanban task id; defaults to the assigned task in a dispatcher worker."}
               "summary" {"type" "string"} "result" {"type" "string"}
               "metadata" {"type" "object"} "created_cards" {"type" "array" "items" {"type" "string"}}
               "artifacts" {"type" "array" "items" {"type" "string"}}
               "board" {"type" "string" "description" "Optional Kanban board slug."}}
              [])
   "kanban_block"
   (fn-schema "kanban_block" "Stop work on a Kanban task and route it as dependency, human input, capability, or transient blocker."
              {"task_id" {"type" "string" "description" "Kanban task id; defaults to the assigned task in a dispatcher worker."}
               "reason" {"type" "string" "description" "Short explanation shown on the board."}
               "kind" {"type" "string" "enum" ["dependency" "needs_input" "capability" "transient"]}
               "board" {"type" "string" "description" "Optional Kanban board slug."}}
              ["reason"])
   "kanban_request_review"
   (fn-schema "kanban_request_review" "Move a Kanban implementation into the review phase and optionally assign a reviewer."
              {"task_id" {"type" "string"} "summary" {"type" "string"}
               "metadata" {"type" "object"} "reviewer" {"type" "string"}
               "artifacts" {"type" "array" "items" {"type" "string"}}
               "board" {"type" "string" "description" "Optional Kanban board slug."}}
              ["summary"])
   "kanban_request_changes"
   (fn-schema "kanban_request_changes" "Return a reviewed Kanban task to its implementer with a reason."
              {"task_id" {"type" "string"} "reason" {"type" "string"}
               "board" {"type" "string" "description" "Optional Kanban board slug."}}
              ["reason"])
   "kanban_link"
   (fn-schema "kanban_link" "Add a parent-to-child dependency edge between existing Kanban tasks."
              {"parent_id" {"type" "string"} "child_id" {"type" "string"}
               "board" {"type" "string" "description" "Optional Kanban board slug."}}
              ["parent_id" "child_id"])
   "kanban_unblock"
   (fn-schema "kanban_unblock" "Unblock a task and restore its resumable phase, respecting parent dependencies. Orchestrator-only."
              {"task_id" {"type" "string"} "board" {"type" "string" "description" "Optional Kanban board slug."}}
              ["task_id"])
   "kanban_create"
   (fn-schema "kanban_create" "Create an assigned Kanban task, optionally gated by parent tasks."
              {"title" {"type" "string"} "assignee" {"type" "string"} "body" {"type" "string"}
               "parents" {"type" "array" "items" {"type" "string"}}
               "tenant" {"type" "string"} "priority" {"type" "integer"}
               "workspace_kind" {"type" "string" "enum" ["scratch" "dir" "worktree"]}
               "workspace_path" {"type" "string"} "project" {"type" "string"}
               "triage" {"type" "boolean"} "idempotency_key" {"type" "string"}
               "max_runtime_seconds" {"type" "integer"} "initial_status" {"type" "string" "enum" ["running" "blocked"]}
               "skills" {"type" "array" "items" {"type" "string"}}
               "goal_mode" {"type" "boolean"} "goal_max_turns" {"type" "integer"}
               "completion_contract" {"type" "string"} "model" {"type" "string"}
               "provider" {"type" "string"} "board" {"type" "string"}}
              ["title" "assignee"])
   "kanban_attachments"
   (fn-schema "kanban_attachments" "List files attached to a Kanban task, including their stored paths and metadata."
              {"task_id" {"type" "string"} "board" {"type" "string" "description" "Optional Kanban board slug."}}
              [])
   "kanban_attach"
   (fn-schema "kanban_attach" "Attach a base64-encoded file to a Kanban task."
              {"task_id" {"type" "string"} "filename" {"type" "string"}
               "content_base64" {"type" "string"} "content_type" {"type" "string"}
               "board" {"type" "string" "description" "Optional Kanban board slug."}}
              ["task_id" "filename" "content_base64"])
   "kanban_attach_url"
   (fn-schema "kanban_attach_url" "Download a public http(s) URL and attach its bytes to a Kanban task (25 MB maximum)."
              {"task_id" {"type" "string"} "url" {"type" "string"} "filename" {"type" "string"}
               "content_type" {"type" "string"} "board" {"type" "string" "description" "Optional Kanban board slug."}}
              ["url"])
   "kanban_comment"
   (fn-schema "kanban_comment" "Append a durable comment to a Hermes Kanban task. The author is the active Kotoba profile; callers cannot impersonate another profile."
              {"task_id" {"type" "string" "description" "Kanban task id."}
               "body" {"type" "string" "description" "Markdown comment to add to the task thread."}
               "board" {"type" "string" "description" "Optional Kanban board slug."}}
              ["task_id" "body"])
   "ha_list_entities"
   (fn-schema "ha_list_entities" "List Home Assistant entities, optionally filtered by domain or area."
              {"domain" {"type" "string"} "area" {"type" "string"}} [])
   "ha_get_state"
   (fn-schema "ha_get_state" "Get one Home Assistant entity state and attributes."
              {"entity_id" {"type" "string"}} ["entity_id"])
   "ha_list_services"
   (fn-schema "ha_list_services" "List Home Assistant services, optionally filtered by domain."
              {"domain" {"type" "string"}} [])
   "ha_call_service"
   (fn-schema "ha_call_service" "Call a Home Assistant service. Shell, scripting, add-on, and REST-command domains are blocked."
              {"domain" {"type" "string"} "service" {"type" "string"}
               "entity_id" {"type" "string"} "data" {"type" "string"}}
              ["domain" "service"])
   "computer_use" (computer-use/schema)})

(def hermes-core-tools
  ;; Source of truth: Hermes `toolsets.py::_HERMES_CORE_TOOLS`. Keep the full
  ;; advertised surface here, including tools Kotoba has not implemented yet.
  ;; `loop/run` checks this list and refuses an incomplete runtime instead of
  ;; quietly presenting a smaller toolset under a Hermes-compatible name.
  ["web_search" "web_extract" "terminal" "process_manage"
   "read_file" "write_file" "patch" "search_files"
   "vision_analyze" "image_generate" "skills_list" "skill_view" "skill_manage"
   "browser_navigate" "browser_snapshot" "browser_click" "browser_type"
   "browser_scroll" "browser_back" "browser_press" "browser_get_images"
   "browser_vision" "browser_console" "browser_cdp" "browser_dialog"
   "browser_vault_list" "browser_vault_unlock" "browser_vault_fill"
   "browser_vault_save_login" "browser_vault_enter_code" "browser_exec"
   "text_to_speech" "todo_list" "memory" "session_search" "clarify"
   "execute_code" "delegate_task" "cronjob_manage"
   "ha_list_entities" "ha_get_state" "ha_list_services" "ha_call_service"
   "kanban_show" "kanban_list" "kanban_complete" "kanban_block"
   "kanban_request_review" "kanban_request_changes" "kanban_heartbeat"
   "kanban_comment" "kanban_create"
   "kanban_attach" "kanban_attach_url" "kanban_attachments" "computer_use"
   "manage_connections"])

(def hermes-api-tools
  (vec (remove #(or (#{"text_to_speech" "clarify" "computer_use"} %)
                    (str/starts-with? % "kanban_"))
                hermes-core-tools)))

(def browser-tools
  ["browser_navigate" "browser_snapshot" "browser_click" "browser_type"
   "browser_scroll" "browser_back" "browser_press" "browser_get_images"
   "browser_vision" "browser_console" "browser_cdp" "browser_dialog"
   "browser_vault_list" "browser_vault_unlock" "browser_vault_fill"
   "browser_vault_save_login" "browser_vault_enter_code" "browser_exec"])

(def toolsets
  (let [file-tools ["read_file" "write_file" "patch" "search_files"]
        skill-tools ["skills_list" "skill_view" "skill_manage"]
        web-tools ["web_search" "web_extract"]
        channel-bundles ["hermes-telegram" "hermes-whatsapp" "hermes-slack"
                         "hermes-signal" "hermes-bluebubbles"
                         "hermes-homeassistant" "hermes-email" "hermes-sms"
                         "hermes-mattermost" "hermes-matrix" "hermes-dingtalk"
                         "hermes-wecom" "hermes-wecom-callback" "hermes-weixin" "hermes-qqbot"]]
    (merge
     {"terminal" ["terminal" "process_manage"]
      "file" file-tools "files" file-tools "web" web-tools "search" ["web_search"]
      "x_search" ["x_search"] "vision" ["vision_analyze"] "video" ["video_analyze"]
      "image_gen" ["image_generate"] "video_gen" ["video_generate" "xai_video_edit" "xai_video_extend"]
      "computer_use" ["computer_use"] "skills" skill-tools "browser" browser-tools
      "cronjob" ["cronjob_manage"] "tts" ["text_to_speech"] "todo" ["todo_list"]
      "memory" ["memory"] "session_search" ["session_search"] "connections" ["manage_connections"]
      "bot_room" [] "context_engine" []
      "project" ["desktop_project"] "desktop_ui" ["read_terminal" "close_terminal" "desktop_preview"
                                                    "drive_preview" "annotate_preview" "read_window_below"
                                                    "focus_pane" "react_to_message" "gui_tour" "show_tip"]
      "setup" ["manage_catalog"] "clarify" ["clarify"] "code_execution" ["execute_code"]
      "delegation" ["delegate_task"] "homeassistant" ["ha_list_entities" "ha_get_state" "ha_list_services" "ha_call_service"]
      "kanban" (filter #(str/starts-with? % "kanban_") hermes-core-tools)
      "debugging" ["terminal" "process_manage" "web_search" "web_extract" "read_file" "write_file" "patch" "search_files"]
      "safe" ["web_search" "web_extract" "vision_analyze" "image_generate"]
      "coding" (vec (remove #{"image_generate" "text_to_speech" "cronjob_manage" "computer_use"
                              "ha_list_entities" "ha_get_state" "ha_list_services" "ha_call_service"}
                            (remove #(str/starts-with? % "kanban_") hermes-core-tools)))
      "hermes-api-server" hermes-api-tools
      "hermes-cli" hermes-core-tools
      "hermes-cron" hermes-core-tools
      "hermes-acp" (vec (remove #{"clarify"} hermes-core-tools))
      "hermes-discord" (into hermes-core-tools ["discord" "discord_admin"])
      "hermes-feishu" (into hermes-core-tools ["feishu_doc_read" "feishu_drive_list_comments"
                                                "feishu_drive_list_comment_replies" "feishu_drive_reply_comment"
                                                "feishu_drive_add_comment"])
      "hermes-yuanbao" (into hermes-core-tools ["yb_query_group_info" "yb_query_group_members"
                                                 "yb_send_dm" "yb_search_sticker" "yb_send_sticker"])
      "hermes-webhook" ["web_search" "web_extract" "vision_analyze" "clarify"]
      "hermes-gateway" (into hermes-core-tools ["discord" "discord_admin" "feishu_doc_read"
                                                 "feishu_drive_list_comments" "feishu_drive_list_comment_replies"
                                                 "feishu_drive_reply_comment" "feishu_drive_add_comment"
                                                 "yb_query_group_info" "yb_query_group_members" "yb_send_dm"
                                                 "yb_search_sticker" "yb_send_sticker"])
      "discord" ["discord"] "discord_admin" ["discord_admin"]
      "yuanbao" ["yb_query_group_info" "yb_query_group_members" "yb_send_dm" "yb_search_sticker" "yb_send_sticker"]
      "feishu_doc" ["feishu_doc_read"]
      "feishu_drive" ["feishu_drive_list_comments" "feishu_drive_list_comment_replies"
                      "feishu_drive_reply_comment" "feishu_drive_add_comment"]
      "spotify" ["spotify_playback" "spotify_devices" "spotify_queue" "spotify_search"
                 "spotify_playlists" "spotify_albums" "spotify_library"]
      "no_mcp" []}
     (zipmap channel-bundles (repeat hermes-core-tools)))))

(defn tool-names
  "Resolve toolsets or direct tool names; run preflight rejects unknown toolsets."
  [sets]
  (vec (distinct (mapcat #(or (get toolsets %)
                               (when (contains? schemas %) [%])
                               []) sets))))

(defn unsupported-tools
  "Tool names this Kotoba agent cannot execute. Callers at compatibility
  boundaries should fail closed instead of silently dropping these tools."
  [names]
  (vec (distinct (remove (set (keys schemas)) names))))

(defn unsupported-toolsets
  "Toolset names neither implemented by Kotoba nor in Hermes' current catalog."
  ([sets] (unsupported-toolsets sets #{}))
  ([sets additional]
   (vec (distinct (remove #(or (contains? toolsets %) (contains? schemas %) (contains? additional %)
                               (and (string? %) (str/starts-with? % "mcp-")
                                    (contains? additional (subs % 4)))) sets)))))

(def approval-free-tools #{"read_file" "search_files" "web_search" "web_extract" "skills_list" "skill_view" "todo_list" "delegate_task"
                           "browser_snapshot" "browser_get_images"
                           "ha_list_entities" "ha_get_state" "ha_list_services"})

(defn approval-required?
  ([name] (approval-required? name nil))
  ([name args]
   (cond
     (= name "cronjob_manage") (not= "list" (get args "action"))
     (= name "computer_use") (not (contains? #{"capture" "list_apps" "list_windows" "wait"}
                                              (get args "action")))
     :else (not (contains? approval-free-tools name)))))

(defn enabled-tool-names
  "Requested toolsets minus the profile's `agent.disabled_toolsets` (Hermes
  config.yaml; Hermes subtracts them last, after every enable, and so do
  we). A toolset itonami-agent does not implement (browser, x_search) names
  no tools here and subtracts nothing."
  [requested disabled]
  (let [off (set (tool-names disabled))]
    (vec (remove off (tool-names requested)))))

(defn execution-disabled-toolsets [config platform]
  "Return Hermes' profile denylist plus platform-specific execution denies."
  (let [configured (get-in config ["agent" "disabled_toolsets"])
        configured (if (string? configured) [configured] configured)]
    (vec (distinct
          (concat (filter string? configured)
                  (when (= platform "cron")
                    (concat ["messaging" "clarify"]
                            (when-not (true? (get-in config ["cron" "allow_agent_scheduling"]))
                              ["cronjob"]))))))))

(defn runtime-tool-names
  "Resolve tools that Hermes would actually expose in this profile. Hermes gates
  browser_cdp and browser_dialog together on a configured CDP endpoint; neither
  belongs in the local browser surface when no endpoint is configured. Kotoba's
  local browser commands also require the agent-browser CLI on PATH."
  ([requested disabled cdp-configured? browser-cli-available?]
   (runtime-tool-names requested disabled cdp-configured? browser-cli-available?
                       (computer-use/cli-available? {})))
  ([requested disabled cdp-configured? browser-cli-available? computer-cli-available?]
   (let [names (enabled-tool-names requested disabled)]
     (vec (remove (fn [name]
                    (or (and (not cdp-configured?)
                             (contains? #{"browser_cdp" "browser_dialog"} name))
                        (and (not browser-cli-available?)
                             (some #{name} browser-tools))
                        (and (= name "computer_use") (not computer-cli-available?))))
                  names)))))

(defn tool-schemas [names] (vec (keep schemas names)))

;; ---------------------------------------------------------------- helpers

(defn- ok [m] (h/json-str m))
(defn- err [msg] (h/json-str {"error" msg}))

(defn- resolve-path [ctx p]
  (let [p (h/expand (str p))]
    (if (str/starts-with? p "/") p (h/join (:cwd ctx) p))))

(defn- writable? [ctx abs]
  (or (nil? (:roots ctx))
      (some #(or (= abs %) (str/starts-with? abs (str % "/"))) (:roots ctx))))

(defn- policy [ctx] (or (:terminal-policy ctx) (confine/policy nil {})))
(defn- host-home [ctx] (or (:host-home ctx) (h/home-dir)))
(defn- backend [ctx] (if (contains? ctx :sandbox-backend) (:sandbox-backend ctx) (confine/backend)))

(defn- read-roots
  "Readable under :roots scope: the run's roots plus the profile home it runs
  from (on a peer, the materialized bundle: SOUL, data/, skills)."
  [ctx]
  (vec (distinct (remove nil? (concat (or (:roots ctx) [(:cwd ctx)]) [(:home ctx)])))))

(defn- readable?
  "Whether `tool` may read `abs`; a refusal is written to the sandbox audit log."
  [ctx tool abs]
  (let [pol (policy ctx)
        why (confine/read-denial pol {:path abs :roots (read-roots ctx) :home (host-home ctx)})]
    (when why
      (confine/audit-denied! {:tool tool :profile (:profile ctx) :peer? (:peer? pol) :path abs :reason why}))
    (nil? why)))

(defn- record-write! [ctx abs]
  (when-let [w (:writes ctx)] (swap! w conj abs)))

(defn- clip [s n] (if (> (count s) n) (str (subs s 0 n) "\n…[truncated " (- (count s) n) " chars]") s))

;; ---------------------------------------------------------------- tools

(defn terminal
  "A shell command under the OS sandbox of ctx's :terminal-policy (see
  itonami.agent.confine): writes only inside the run's roots (or its cwd),
  no secret stores, no network unless granted, only the env it names."
  [ctx {:strs [command timeout workdir background]}]
  (let [cwd (if workdir (resolve-path ctx workdir) (:cwd ctx))
        pol (policy ctx)]
    (if (and (:roots ctx) (not (writable? ctx cwd)))
      (err (str "workdir outside this run's roots: " cwd))
      (let [c (confine/command pol {:cmd (str command)
                                    :write-roots (or (:roots ctx) [(:cwd ctx)])
                                    :read-roots (read-roots ctx)
                                    :tool-env (:tool-env ctx)
                                    :home (host-home ctx)
                                    :backend (backend ctx)})]
        (if-let [why (:refused c)]
          (err (str "terminal refused: " why))
          (if background
            (process/spawn! ctx {:argv (:argv c) :env (:env c) :cwd cwd :tmpdir (:tmpdir c)
                                 :command (str command)
                                 :on-exit (fn [exit stderr]
                                            (confine/audit! {:profile (:profile ctx) :peer? (:peer? pol)
                                                             :sandbox (:sandbox c) :cmd (str command)
                                                             :exit exit :stderr stderr :timed-out? false}))})
            (let [r (try (h/run-process (:argv c) {:cwd cwd :exact-env? true :env (:env c)
                                                   :timeout-ms (* 1000 (or timeout (:terminal-timeout-s ctx) 180))})
                         (finally (when (:tmpdir c) (h/rm (:tmpdir c)))))]
              (confine/audit! {:profile (:profile ctx) :peer? (:peer? pol) :sandbox (:sandbox c)
                               :cmd (str command) :exit (:exit r) :stderr (:stderr r)
                               :timed-out? (:timed-out? r)})
              (ok {"output" (clip (str (:stdout r) (when-not (str/blank? (:stderr r)) (str "\n[stderr]\n" (:stderr r)))) 50000)
                   "exit_code" (:exit r)
                   "sandbox" (name (:sandbox c))
                   "error" (when (:timed-out? r) "timeout")}))))))))

(defn read-file [ctx {:strs [path offset limit]}]
  (let [abs (resolve-path ctx path)]
    (cond
      ;; checked before existence, so a denied path does not leak whether it exists
      (not (readable? ctx "read_file" abs)) (err (str "path not readable under this run's policy: " abs))
      (not (h/file? abs)) (err (str "file not found: " abs))
      :else
      (let [ls (str/split-lines (h/slurp abs))
            off (max 1 (or offset 1))
            lim (min 2000 (or limit 2000))
            sel (take lim (drop (dec off) ls))]
        (ok {"content" (str/join "\n" (map-indexed (fn [i l] (str (.padStart (str (+ off i)) 6 " ") "|" l)) sel))
             "total_lines" (count ls)
             "truncated" (> (count ls) (+ (dec off) lim))})))))

(defn write-file [ctx {:strs [path content]}]
  (let [abs (resolve-path ctx path)]
    (if-not (writable? ctx abs)
      (err (str "path outside this run's roots: " abs))
      (do (h/spit abs (str content))
          (record-write! ctx abs)
          (ok {"bytes_written" (count (str content)) "path" abs})))))

(defn patch [ctx {:strs [path old_string new_string replace_all]}]
  (let [abs (resolve-path ctx path)]
    (cond
      (not (writable? ctx abs)) (err (str "path outside this run's roots: " abs))
      (not (h/file? abs)) (err (str "file not found: " abs))
      :else
      (let [s (h/slurp abs)
            n (count (re-seq (re-pattern (str/replace old_string #"[.*+?^${}()|\[\]\\]" "\\$&")) s))]
        (cond
          (zero? n) (err "old_string not found")
          (and (> n 1) (not replace_all)) (err (str "old_string found " n " times; pass replace_all or add context"))
          :else (do (h/spit abs (if replace_all (str/replace s old_string new_string) (str/replace-first s old_string new_string)))
                    (record-write! ctx abs)
                    (ok {"replacements" (if replace_all n 1) "path" abs})))))))

(defn search-files
  "rg / grep / find, run under the same sandbox as `terminal` (read-only,
  offline), so a search over a broad path cannot read the secret stores
  inside it -- and under :roots scope nothing in the home directory but the
  run's roots."
  [ctx {:strs [pattern target path file_glob limit]}]
  (let [dir (resolve-path ctx (or path "."))
        lim (or limit 50)]
    (if-not (readable? ctx "search_files" dir)
      (err (str "path not readable under this run's policy: " dir))
      (let [rg? (zero? (:exit (h/run-process ["which" "rg"] {})))
            argv (if (= target "files")
                   (if rg? ["rg" "--files" "-g" pattern dir] ["find" dir "-name" pattern])
                   (if rg?
                     (cond-> ["rg" "-n" "--no-heading" "-m" "20"] file_glob (into ["-g" file_glob]) true (into ["-e" pattern dir]))
                     ["grep" "-rnE" pattern dir]))
            c (confine/command (assoc (policy ctx) :network? false :write-extra [])
                               {:argv argv :write-roots [] :read-roots (read-roots ctx)
                                :tool-env {} :home (host-home ctx) :backend (backend ctx)})]
        (if-let [why (:refused c)]
          (err (str "search_files refused: " why))
          (let [r (try (h/run-process (:argv c) {:exact-env? true :env (:env c) :timeout-ms 30000})
                       (finally (when (:tmpdir c) (h/rm (:tmpdir c)))))
                hits (take lim (remove str/blank? (str/split-lines (:stdout r))))]
            (ok {"matches" (vec hits) "count" (count hits)})))))))

(defn- strip-html [html]
  (-> html
      (str/replace #"(?is)<(script|style|noscript)[^>]*>.*?</\1>" " ")
      (str/replace #"(?i)<br\s*/?>|</p>|</div>|</li>|</h[1-6]>" "\n")
      (str/replace #"<[^>]+>" " ")
      (str/replace #"&nbsp;" " ") (str/replace #"&amp;" "&") (str/replace #"&lt;" "<")
      (str/replace #"&gt;" ">") (str/replace #"&quot;" "\"") (str/replace #"&#39;" "'")
      (str/replace #"[ \t]+" " ") (str/replace #"\n\s*\n+" "\n\n") str/trim))

(defn web-extract
  "Fetch up to 5 URLs through itonami.agent.webguard: public addresses only
  (no loopback / LAN / tailscale / cloud metadata, judged at connect time),
  http(s) only, redirects re-checked, 2 MB cap, and the profile's
  :web :allow when set. Each URL is one line in the sandbox audit log."
  [ctx {:strs [urls char_limit]}]
  (let [pol (policy ctx)
        audit (fn [m] (confine/audit-web! (merge {:profile (:profile ctx) :peer? (:peer? pol)} m)))]
    (p/let [res (p/all (for [u (take 5 urls)]
                         (-> (webguard/fetch-text (str u) {:allow (:web-allow pol)
                                                           :public-override (:web-public-override ctx #{})})
                             (p/then (fn [{:keys [status text redirects truncated?]}]
                                       (audit {:url (str u) :status status :redirects redirects})
                                       (cond-> {"url" u "status" status "content" (clip (strip-html text) (or char_limit 15000))}
                                         truncated? (assoc "truncated" true))))
                             (p/catch (fn [e]
                                        (let [reason (:denied (ex-data e))]
                                          (audit {:url (str u) :denied (boolean reason) :reason (or reason :error)})
                                          {"url" u "error" (.-message e)}))))))]
      (ok {"results" (vec res)}))))

(def ^:private image-types
  {"jpg" "image/jpeg" "jpeg" "image/jpeg" "png" "image/png"
   "webp" "image/webp" "gif" "image/gif"})

(declare vision-complete)

(defn vision-analyze
  "Analyze a bounded image with the active Kotoba provider chain."
  [ctx {:strs [image_url question]}]
  (let [source (str/trim (str image_url))
        q (str/trim (str question))
        cap (* 5 1024 1024)
        image-data
        (cond
          (str/starts-with? source "data:")
          (when (<= (count source) 6990600)
            (when-let [[_ mime b64] (re-matches #"(?is)^data:(image/(?:jpeg|png|webp|gif));base64,([A-Za-z0-9+/]*={0,2})$" source)]
            (let [bytes (.from js/Buffer b64 "base64")]
              (when (and (pos? (.-length bytes)) (<= (.-length bytes) cap))
                {:mime mime :base64 (.toString bytes "base64")}))))

          (re-matches #"(?i)^https?://.+" source) nil

          :else
          (let [path (resolve-path ctx source)
                real (try (h/realpath path) (catch :default _ nil))
                ext (some-> path (str/split #"\.") last str/lower-case)
                mime (get image-types ext)]
            (when (and real mime (h/file? real) (readable? ctx "vision_analyze" real))
              (when (<= (h/file-size real) cap)
                (let [bytes (h/slurp-bytes real)]
                  (when (pos? (.-length bytes))
                    {:mime mime :base64 (.toString bytes "base64")}))))))]
    (cond
      (str/blank? source) (p/resolved (err "image_url is required"))
      (str/blank? q) (p/resolved (err "question is required"))
      (str/starts-with? source "data:")
      (if image-data
        (vision-complete ctx q image-data)
        (p/resolved (err "vision_analyze: data URL must be base64 JPEG, PNG, WebP, or GIF up to 5 MiB")))
      (re-matches #"(?i)^https?://.+" source)
      (-> (webguard/fetch-bytes source {:max-bytes cap :allow (:web-allow (policy ctx))
                                        :public-override (:web-public-override ctx #{})})
          (p/then (fn [{:keys [status content-type bytes truncated?]}]
                    (let [mime (some-> content-type (str/split #";") first str/lower-case str/trim)]
                      (cond
                        (not (<= 200 status 299)) (err (str "vision_analyze: HTTP " status))
                        truncated? (err "vision_analyze: image exceeds 5 MiB limit")
                        (not (contains? (set (vals image-types)) mime)) (err "vision_analyze: URL did not return JPEG, PNG, WebP, or GIF")
                        :else (vision-complete ctx q {:mime mime :base64 (.toString bytes "base64")})))))
          (p/catch (fn [e] (err (str "vision_analyze: " (.-message e))))) )
      image-data (vision-complete ctx q image-data)
      :else (p/resolved (err "vision_analyze: local image must be readable JPEG, PNG, WebP, or GIF up to 5 MiB")))))

(defn- vision-complete [ctx question {:keys [mime base64]}]
  (if (seq (:model-hops ctx))
    (-> (provider/complete (:model-hops ctx) (:tool-env ctx)
                           {:messages [{"role" "user" "content"
                                        [{"type" "text" "text" question}
                                         {"type" "image_url" "image_url" {"url" (str "data:" mime ";base64," base64)}}]}]
                            :reasoning-effort (:reasoning-effort ctx)
                            :max-tokens 2048 :rounds 1})
        (p/then (fn [r]
                  (if-let [msg (get-in r [:ok :message])]
                    (ok {"success" true "analysis" (get msg "content")
                         "provider" (get-in r [:ok :provider]) "model" (get-in r [:ok :model])})
                    (err (str "vision_analyze: " (get-in r [:err :error] "no multimodal provider available"))))))
        (p/catch (fn [e] (err (str "vision_analyze: " (.-message e))))))
    (p/resolved (err "vision_analyze: no provider chain is available"))))

(defn- browser-vision [ctx {:strs [question annotate]}]
  (if (str/blank? (str question))
    (p/resolved (err "browser_vision: question is required"))
    (let [dir (h/join (:home ctx) "data" "browser")
          path (h/join dir (str "vision-" (h/random-hex 8) ".png"))
          cleanup (fn [value] (h/rm path) value)]
      (h/mkdirs dir)
      (-> (browser/screenshot ctx path annotate)
          (p/then (fn [raw]
                    (let [result (try (h/json-parse raw) (catch :default _ nil))]
                      (if (and result (not= false (get result "success")))
                        (-> (vision-analyze ctx {"image_url" path "question" question})
                            (p/then cleanup)
                            (p/catch (fn [e] (h/rm path) (err (str "browser_vision: " (.-message e))))))
                        (do (h/rm path) raw)))))
          (p/catch (fn [e] (h/rm path) (err (str "browser_vision: " (.-message e)))))))))

(def search-endpoint "https://html.duckduckgo.com/html/?q=")

(defn web-search
  "Keyless DuckDuckGo HTML search through itonami.agent.webguard (public
  address, 2 MB cap, the profile's :web :allow -- a profile with an
  allowlist must list html.duckduckgo.com to search). The query is checked
  before it leaves the host: no secrets, encoded blobs, e-mail addresses or
  phone numbers, at most 256 chars. The audit log keeps its length and
  hash, never its text."
  [ctx {:strs [query limit]}]
  (let [pol (policy ctx)
        q (str query)
        audit (fn [m] (confine/audit-web! (merge {:tool "web_search" :profile (:profile ctx) :peer? (:peer? pol) :query q} m)))]
    (if-let [why (webguard/query-refusal q)]
      (do (audit {:denied true :reason why})
          (p/resolved (err (str "web_search refused: query looks like it carries " (name why)
                                " -- search with general words, not with secrets or a person's details"))))
      (-> (webguard/fetch-text (str (:search-endpoint ctx search-endpoint) (js/encodeURIComponent q))
                               {:allow (:web-allow pol) :public-override (:web-public-override ctx #{})})
          (p/then (fn [{:keys [text status]}]
                    (audit {:status status})
                    (let [hits (->> (re-seq #"(?s)class=\"result__a\" href=\"([^\"]+)\"[^>]*>(.*?)</a>.*?class=\"result__snippet\"[^>]*>(.*?)</a>" text)
                                    (map (fn [[_ href title snip]]
                                           (let [u (or (some-> (re-find #"uddg=([^&]+)" href) second js/decodeURIComponent) href)]
                                             {"url" u "title" (strip-html title) "description" (strip-html snip)})))
                                    (take (or limit 8)))]
                      (ok {"results" (vec hits)}))))
          (p/catch (fn [e]
                     (let [reason (:denied (ex-data e))]
                       (audit {:denied (boolean reason) :reason (or reason :error)})
                       (err (str "web_search: " (.-message e))))))))))

(defn skills-list [ctx {:strs [category]}]
  (let [skills-dir (h/join (:home ctx) "skills")
        rels (if (h/dir? skills-dir)
               (filter #(= "SKILL.md" (last (str/split % #"/")))
                       (h/walk-files skills-dir (fn [rel] (some #(str/starts-with? % ".") (str/split rel #"/")))))
               [])
        skills (->> rels
                    (keep (fn [rel]
                            (let [f (h/join skills-dir rel)]
                              (when (readable? ctx "skills_list" f)
                                (try
                                  (let [s (h/slurp f)
                                        fm (second (re-find #"(?s)^---\s*\n(.*?)\n---(?:\n|$)" s))
                                        parsed (when fm (yaml/parse fm))
                                        meta (if (map? parsed) parsed {})
                                        parts (str/split rel #"/")
                                        nm (nth parts (- (count parts) 2) "")
                                        desc (or (get meta "description") "")
                                        cat (when (= 3 (count parts)) (first parts))]
                                    ;; skill_view resolves only <name>/SKILL.md and <category>/<name>/SKILL.md.
                                    (when (and (#{2 3} (count parts)) (seq (str nm))
                                               (or (nil? category) (= category cat)))
                                      (cond-> {"name" (str nm) "description" (str desc)}
                                        cat (assoc "category" cat))))
                                  (catch :default _ nil))))))
                    (sort-by (juxt #(or (get % "category") "") #(get % "name")))
                    vec)
        categories (->> skills (keep #(get % "category")) distinct sort vec)]
    (ok {"success" true "skills" skills "categories" categories
         "message" (when (empty? skills) "No skills found in this profile's skills/ directory.")})))

(declare todo-item todo-dedupe)

(defn todo-history-state [history]
  (loop [[m & more] history calls {} state {:todos [] :revision 0}]
    (if-not m
      state
      (let [role (get m "role")]
        (cond
          (= role "assistant")
          (let [calls' (reduce (fn [acc c]
                                 (assoc acc (get c "id") (get-in c ["function" "name"])))
                               calls (get m "tool_calls"))]
            (recur more calls' state))
          (= role "tool")
          (if (= "todo_list" (get calls (get m "tool_call_id")))
            (let [content (get m "content" "")
                  parsed (when (and (string? content) (<= (count content) 512000))
                           (try (h/json-parse content) (catch :default _ nil)))
                  raw (when (and (map? parsed) (vector? (get parsed "todos"))) (get parsed "todos"))
                  items (when raw
                          (try (todo-dedupe (->> raw (filter map?) (take 256) vec))
                               (catch :default _ [])))
                  rev (when (map? parsed) (get parsed "revision"))
                  next-state (if raw
                               {:todos items :revision (if (and (number? rev) (>= rev 0)) rev 0)}
                               state)]
              (recur more calls next-state))
            (recur more calls state))
          :else (recur more calls state))))))

(defn- todo-item [item]
  (when-not (map? item)
    (throw (ex-info "todo item must be an object" {})))
  (let [id (str/trim (str (get item "id" "")))
        content (str/trim (str (get item "content" "")))
        status (str/lower-case (str/trim (str (get item "status" "pending"))))
        parent (str/trim (str (get item "parent" "")))
        marker "… [truncated]"
        content (if (> (count content) 4000)
                  (str (subs content 0 (- 4000 (count marker))) marker) content)]
    (when (str/blank? content)
      (throw (ex-info (str "Todo item '" (if (str/blank? id) "?" id) "' has empty or missing content.") {})))
    (cond-> {"id" (if (str/blank? id) "?" id)
             "content" content
             "status" (if (#{"pending" "in_progress" "completed" "cancelled"} status) status "pending")}
      (and (not (str/blank? parent)) (not= parent id)) (assoc "parent" parent))))

(defn- todo-sanitize-parents [items]
  (let [by-id (into {} (map (juxt #(get % "id") identity) items))]
    (mapv (fn [item]
            (loop [node item seen #{(get item "id")}]
              (if-let [parent (get node "parent")]
                (cond
                  (contains? seen parent) (dissoc item "parent")
                  (not (contains? by-id parent)) (dissoc item "parent")
                  :else (recur (get by-id parent) (conj seen parent)))
                item)))
          items)))

(defn- todo-normalize-order [items]
  (let [active (first (keep-indexed #(when (= "in_progress" (get %2 "status")) %1) items))
        pending (first (keep-indexed #(when (= "pending" (get %2 "status")) %1) items))]
    (if (and (not-any? #(get % "parent") items) active pending (< pending active))
      (vec (concat (subvec items 0 pending) [(get items active)]
                   (subvec items pending active) (subvec items (inc active))))
      items)))

(defn- todo-dedupe [items]
  (let [clean (mapv todo-item items)
        last-index (reduce-kv (fn [acc i item] (assoc acc (get item "id") i)) {} clean)
        ordered (->> last-index (sort-by val) (mapv (fn [[_ i]] (get clean i))) (take 256) vec)]
    (todo-normalize-order (todo-sanitize-parents ordered))))

(defn- todo-list [ctx {:strs [todos merge]}]
  (let [items-atom (:todos ctx)
        revision-atom (:todo-revision ctx)]
    (try
      (when (some? todos)
        (when-not (vector? todos)
          (throw (ex-info "todos must be a list" {})))
        (let [before @items-atom
              next (if merge
                     (reduce (fn [acc raw]
                               (let [id (str/trim (str (get raw "id" "")))]
                                 (if (str/blank? id) acc
                                   (if-let [idx (first (keep-indexed #(when (= id (get %2 "id")) %1) acc))]
                                     (let [old (get acc idx)
                                           content (get raw "content")
                                           status (some-> (get raw "status") str str/lower-case str/trim)
                                           updates (cond-> {"id" id}
                                                     (and content (not (str/blank? (str content)))) (assoc "content" content)
                                                     (contains? #{"pending" "in_progress" "completed" "cancelled"} status) (assoc "status" status)
                                                     (contains? raw "parent") (assoc "parent" (get raw "parent")))
                                           item (todo-item (clojure.core/merge old updates))]
                                       (assoc acc idx item))
                                     (conj acc (todo-item raw))))))
                             before todos)
                     (todo-dedupe todos))
              next (todo-dedupe next)]
          (reset! items-atom next)
          (when (not= before next) (swap! revision-atom inc))))
      (let [items @items-atom
            summary (reduce (fn [m status] (assoc m status (count (filter #(= status (get % "status")) items))))
                            {"total" (count items)} ["pending" "in_progress" "completed" "cancelled"])]
        (ok {"todos" items "revision" @revision-atom "summary" summary}))
      (catch :default e (err (.-message e))))))

(defn- skill-name? [s]
  (and (string? s) (<= (count s) 64)
       (re-matches #"^[a-z0-9][a-z0-9._-]*$" s)))

(defn- skill-content-error [content new-skill?]
  (let [content (str content)
        content (if (str/starts-with? content "\uFEFF") (subs content 1) content)]
    (cond
      (str/blank? content) "Content cannot be empty."
      (> (count content) 100000) "SKILL.md content exceeds 100000 characters."
      :else
      (if-let [[_ frontmatter body]
               (re-find #"(?s)^---[ \t]*\r?\n(.*?)\r?\n---[ \t]*\r?\n(.*)$" content)]
        (try
          (let [meta (yaml/parse frontmatter)
                description (str (get meta "description" ""))
                prompt-description (str/trim description)]
            (cond
              (not (map? meta)) "Frontmatter must be a YAML mapping (key: value pairs)."
              (not (contains? meta "name")) "Frontmatter must include 'name' field."
              (not (contains? meta "description")) "Frontmatter must include 'description' field."
              (> (count description) 1024) "Description exceeds 1024 characters."
              (and new-skill? (> (count prompt-description) 60))
              "New skill description must fit the 60-character system-prompt budget."
              (str/blank? body) "SKILL.md must have content after the frontmatter (instructions, procedures, etc.)."
              :else nil))
          (catch :default e (str "YAML frontmatter parse error: " (.-message e))))
        (if (str/starts-with? content "---")
          "SKILL.md frontmatter is not closed. Ensure there is a closing '---' line."
          "SKILL.md must start with YAML frontmatter (---). See existing skills for format.")))))

(defn- safe-skill-relative? [s]
  (and (string? s) (not (str/blank? s))
       (not (str/starts-with? s "/")) (not (str/includes? s "\\"))
       (not (some #{"" ".." "."} (str/split s #"/")))))

(defn- skill-linked-files [dir]
  (let [files (h/walk-files dir (fn [_] false))
        under (fn [folder] (filter #(str/starts-with? % (str folder "/")) files))
        direct? (fn [folder rel]
                  (not (str/includes? (subs rel (inc (count folder))) "/")))
        extension (fn [rel] (some-> rel (str/split #"\.") last str/lower-case))
        refs (filter #(and (direct? "references" %) (= "md" (extension %))) (under "references"))
        template-exts #{"md" "py" "yaml" "yml" "json" "tex" "sh"}
        templates (filter #(contains? template-exts (extension %)) (under "templates"))
        assets (under "assets")
        script-exts #{"py" "sh" "bash" "js" "ts" "rb"}
        scripts (filter #(and (direct? "scripts" %) (contains? script-exts (extension %))) (under "scripts"))]
    (cond-> {}
      (seq refs) (assoc "references" (vec refs))
      (seq templates) (assoc "templates" (vec templates))
      (seq assets) (assoc "assets" (vec assets))
      (seq scripts) (assoc "scripts" (vec scripts)))))

(defn skill-view [ctx {:strs [name file_path]}]
  (let [skills (h/join (:home ctx) "skills")
        parts (when (safe-skill-relative? name) (str/split name #"/"))
        valid-name? (and (#{1 2} (count parts)) (every? skill-name? parts))
        skill-files (if (h/dir? skills) (h/walk-files skills (fn [_] false)) [])
        candidates (when valid-name?
                     (for [rel skill-files
                           :when (and (str/ends-with? rel "/SKILL.md")
                                      (let [segments (str/split rel #"/")
                                            skill-path (vec (butlast segments))]
                                        (and (= (count skill-path) (count parts))
                                             (if (= 1 (count parts))
                                               (= (first parts) (first skill-path))
                                               (= parts skill-path)))))]
                       (h/join skills (subs rel 0 (- (count rel) (count "/SKILL.md"))))))
        dir (first candidates)]
    (cond
      (not valid-name?) (err "skill name must be a name or category/name using safe lowercase path segments")
      (not dir) (err (str "skill not found: " name))
      :else
      (let [relative (or file_path "SKILL.md")
            available (set (h/walk-files dir (fn [_] false)))
            f (when (safe-skill-relative? relative) (h/join dir relative))]
        (cond
          (nil? f) (err "file_path must be a safe relative path within the skill")
          (not (contains? available relative)) (err (str "no such file in skill: " relative))
          (not (readable? ctx "skill_view" f)) (err "skill file is outside this run's readable roots")
          :else
          (let [content (h/slurp f)
                fm (when (= relative "SKILL.md")
                     (second (re-find #"(?s)^---\s*\n(.*?)\n---(?:\n|$)" content)))
                meta (when fm (try (yaml/parse fm) (catch :default _ {})))
                linked (when (= relative "SKILL.md") (skill-linked-files dir))]
            (ok (cond-> {"success" true "name" name "content" content}
                  (map? meta) (assoc "description" (get meta "description" "")
                                     "tags" (get meta "tags" [])
                                     "related_skills" (get meta "related_skills" []))
                  (seq linked) (assoc "linked_files" linked
                                     "usage_hint" (str "To view linked files, call skill_view(name, file_path), for example: "
                                                       (first (mapcat val linked))))))))))))

(defn- skill-dir [ctx name category]
  (let [skills (h/join (:home ctx) "skills")]
    (when (and (skill-name? name)
               (or (nil? category) (skill-name? category)))
      (h/join skills (or category "") name))))

(defn- symlink-under? [root abs]
  (loop [p abs]
    (cond
      (nil? p) false
      (h/symlink? p) true
      (= p root) false
      :else (recur (h/dirname p)))))

(defn- skill-snapshot [dir]
  (when (h/dir? dir)
    (when (seq (h/walk-symlinks dir))
      (throw (ex-info (str "skill contains symbolic links; transactional mutation refused: " dir) {})))
    {:exists true
     :files (into {}
                  (map (fn [rel]
                         (let [file (h/join dir rel)]
                           [rel {"base64" (h/slurp-base64 file) "mode" (h/file-mode file)}]))
                       (h/walk-files dir (fn [_] false))))}))

(defn- restore-skill! [dir snapshot]
  (h/rm dir)
  (when (:exists snapshot)
    (h/mkdirs dir)
    (doseq [[rel file] (:files snapshot)]
      (h/spit-base64 (h/join dir rel) (get file "base64") (get file "mode")))))

(defn- skill-support-path [dir file-path]
  (when (and (string? file-path)
             (not (str/starts-with? file-path "/"))
             (not (str/includes? file-path "\\"))
             (not (some #{"" ".." "."} (str/split file-path #"/")))
             (contains? #{"references" "templates" "scripts" "assets"}
                        (first (str/split file-path #"/"))))
    (h/join dir file-path)))

(defn- substring-count [text needle]
  (loop [offset 0 n 0]
    (let [at (.indexOf text needle offset)]
      (if (neg? at) n (recur (+ at (count needle)) (inc n))))))

(defn- skill-manage-one [ctx op]
  (let [action (get op "action")
        name (get op "name")
        dir (skill-dir ctx name (get op "category"))
        skill-file (when dir (h/join dir "SKILL.md"))
        skills-root (h/join (:home ctx) "skills")
        support (when dir (skill-support-path dir (get op "file_path")))
        fail (fn [s] (err s))]
    (cond
      (not dir) (fail "name/category must use lowercase letters, digits, hyphens, or underscores; name is limited to 64 characters")
      (not (writable? ctx dir)) (fail "skill path is outside this run's writable roots")
      (or (symlink-under? skills-root dir) (and support (symlink-under? skills-root support)))
      (fail "skill_manage refuses paths that traverse a symbolic link")
      (= action "create")
      (cond
        (not (string? (get op "content"))) (fail "create requires full SKILL.md content")
        (skill-content-error (get op "content") true) (fail (skill-content-error (get op "content") true))
        (h/exists? dir) (fail (str "skill already exists: " name))
        :else (do (h/mkdirs dir) (h/spit skill-file (get op "content"))
                  (record-write! ctx skill-file)
                  (ok {"success" true "action" action "name" name "path" skill-file})))

      (= action "delete")
      (if-not (and (h/dir? dir) (h/file? skill-file))
        (fail (str "skill not found: " name))
        (do (h/rm dir) (record-write! ctx dir)
            (ok {"success" true "action" action "name" name})))

      (contains? #{"patch" "write_file" "remove_file"} action)
      (let [target (if (= action "patch") (or support skill-file) support)]
        (cond
          (and (not= action "patch") (nil? support)) (fail "file_path must be a relative path under references/, templates/, scripts/, or assets/")
          (and (= action "patch") (get op "file_path") (nil? support)) (fail "file_path must be a relative path under references/, templates/, scripts/, or assets/")
          (not (h/file? skill-file)) (fail (str "skill not found: " name))
          (= action "write_file")
          (if-not (string? (get op "file_content"))
            (fail "write_file requires file_content")
            (if (> (h/utf8-byte-length (get op "file_content")) 1048576)
              (fail "supporting file content exceeds 1048576 bytes")
              (do (h/spit target (get op "file_content")) (record-write! ctx target)
                  (ok {"success" true "action" action "name" name "file_path" (get op "file_path")}))))
          (= action "remove_file")
          (if-not (h/file? target) (fail (str "file not found: " (get op "file_path")))
            (do (h/rm target) (record-write! ctx target)
                (ok {"success" true "action" action "name" name "file_path" (get op "file_path")})))
          :else
          (let [old (get op "old_string") new (get op "new_string")]
            (cond
              (and (string? (get op "content")) (not (contains? op "old_string")))
              (let [content (get op "content")
                    validation (when (= target skill-file) (skill-content-error content false))]
                (cond
                  validation (fail validation)
                  (> (if (= target skill-file) (count content) (h/utf8-byte-length content))
                     (if (= target skill-file) 100000 1048576)) (fail "skill file content exceeds the allowed size")
                  :else (do (h/spit target content) (record-write! ctx target)
                            (ok {"success" true "action" action "name" name "path" target}))))
              (or (not (string? old)) (str/blank? old) (not (string? new))) (fail "patch requires non-empty old_string and new_string")
              (not (h/file? target)) (fail (str "skill file not found: " (get op "file_path" "SKILL.md")))
              :else
              (let [text (h/slurp target) matches (substring-count text old)
                    replace-all (true? (get op "replace_all"))]
                (cond
                  (zero? matches) (fail "old_string not found")
                  (and (> matches 1) (not replace-all)) (fail (str "old_string matched " matches " times; set replace_all=true or make it unique"))
                  :else (let [updated (if replace-all (str/replace text old new) (str/replace-first text old new))
                              validation (when (= target skill-file) (skill-content-error updated false))]
                          (cond
                            validation (fail validation)
                            (> (if (= target skill-file) (count updated) (h/utf8-byte-length updated))
                               (if (= target skill-file) 100000 1048576)) (fail "skill file content exceeds the allowed size")
                            :else (do (h/spit target updated)
                                      (record-write! ctx target)
                                      (ok {"success" true "action" action "name" name "path" target})))))))))

      :else (fail "unsupported skill_manage action")))))

(defn skill-manage [ctx {:strs [operations]}]
  (cond
    (not (and (vector? operations) (<= 1 (count operations) 20) (every? map? operations)))
    (err "operations must contain between 1 and 20 skill operation objects")
    (and (> (count operations) 1) (some #(= "delete" (get % "action")) operations))
    (err "delete must be the sole skill_manage operation")
    :else
    (let [root (h/join (:home ctx) "skills")
          dirs (mapv #(skill-dir ctx (get % "name") (get % "category")) operations)]
      (cond
        (h/symlink? root) (err "skill_manage refuses a symbolic-link skills directory")
        (some nil? dirs)
        (err "name/category must use lowercase letters, digits, hyphens, or underscores; name is limited to 64 characters")
        :else
        (h/with-lock
         (h/join root ".kotoba-skill-manage.lock")
         (fn []
           (let [snapshots (atom nil)
                 staged-writes (atom [])
                 rollback! (fn []
                             (doseq [[dir snap] @snapshots]
                               (restore-skill! dir snap)))]
             (try
               (doseq [[op dir] (map vector operations dirs)]
                 (let [support (when (get op "file_path")
                                 (skill-support-path dir (get op "file_path")))]
                   (when (or (symlink-under? root dir)
                             (and (get op "file_path") (nil? support))
                             (and support (symlink-under? root support)))
                     (throw (ex-info "skill_manage refuses unsafe or symbolic-link paths" {})))))
               (reset! snapshots (into {} (map (fn [dir] [dir (skill-snapshot dir)]) (distinct dirs))))
               (let [ctx' (assoc ctx :writes staged-writes)
                     outcome (loop [[op & more] operations results []]
                               (if (nil? op)
                                 {:results results}
                                 (let [raw (skill-manage-one ctx' op)
                                       data (try (h/json-parse raw) (catch :default _ {}))]
                                   (if (or (get data "error") (false? (get data "success")))
                                     {:failure raw}
                                     (recur more (conj results data))))))]
                 (if-let [failure (:failure outcome)]
                   (do (rollback!) failure)
                   (do (when-let [writes (:writes ctx)] (swap! writes into @staged-writes))
                       (ok {"success" true "results" (:results outcome)}))))
               (catch :default e
                 (let [rollback-error (try
                                        (when @snapshots (rollback!))
                                        nil
                                        (catch :default rollback-error rollback-error))]
                   (err (cond-> (.-message e)
                          rollback-error (str "; rollback failed: " (.-message rollback-error))))))))))))))

(defn memory [ctx {:strs [action target content old_text new_text]}]
  (let [f (h/join (:home ctx) "memories" (if (= target "user") "USER.md" "MEMORY.md"))
        entries (if (h/file? f) (vec (remove str/blank? (str/split (h/slurp f) #"\n§\n"))) [])
        entries' (case action
                   "add" (conj entries (str content))
                   "replace" (mapv #(if (str/includes? % (str old_text)) (str/replace % old_text (or new_text content "")) %) entries)
                   "remove" (vec (remove #(str/includes? % (str (or old_text content))) entries))
                   entries)]
    (if (and (:roots ctx) (not (writable? ctx f)))
      (err "memory is not writable in this run")
      (do (h/spit f (str/join "\n§\n" entries'))
          (ok {"entries" (count entries')})))))

(defn- sqlite-records [db sql & params]
  (let [stmt (.prepare db sql)]
    (js->clj (js/Reflect.apply (.-all stmt) stmt (clj->js params)))))

(defn session-search
  "Read-only local-profile history search. Cross-profile lookup and Hermes' adaptive detail mode are intentionally unavailable."
  [ctx {:strs [query limit session_id around_message_id window role_filter]}]
  (let [db-path (h/join (:home ctx) "state.db")
        limit (if (number? limit) (max 1 (min 20 (int limit))) 5)
        window (if (number? window) (max 1 (min 20 (int window))) 5)
        role-filter (or role_filter "user,assistant")
        roles (case role-filter
                "user,assistant" ["user" "assistant"]
                "user,assistant,tool" ["user" "assistant" "tool"]
                "user" ["user"]
                "assistant" ["assistant"]
                "tool" ["tool"]
                nil)]
    (cond
      (not roles) (err "session_search role_filter must be one of the advertised values")
      (and around_message_id (not session_id)) (err "session_search around_message_id requires session_id")
      (not (h/file? db-path)) (err "session_search requires this profile's state.db")
      (not (readable? ctx "session_search" db-path)) (err "session_search denied by this run's read policy")
      :else
      (let [db (sqlite/DatabaseSync. db-path #js {:readOnly true})]
        (try
          (.exec db "PRAGMA query_only = ON")
          (let [source-filter "COALESCE(s.source, '') NOT IN ('tool', 'delegate', 'kanban')"
                hidden-filter "COALESCE(s.hidden, 0) = 0"
                role-sql (str/join "," (map #(str "'" % "'") roles))
                result
                (cond
                  session_id
                  (if around_message_id
                    (sqlite-records db
                      (str "WITH numbered AS (SELECT m.id, m.role, m.content, m.timestamp, "
                           "ROW_NUMBER() OVER (ORDER BY m.id) AS rn FROM messages m "
                           "JOIN sessions s ON s.id = m.session_id WHERE s.id = ? AND " hidden-filter " AND " source-filter ") "
                           "SELECT id, role, content, timestamp FROM numbered WHERE rn BETWEEN "
                           "MAX(1, (SELECT rn FROM numbered WHERE id = ?) - ?) AND "
                           "(SELECT rn FROM numbered WHERE id = ?) + ? "
                           "AND (SELECT rn FROM numbered WHERE id = ?) IS NOT NULL ORDER BY rn")
                      session_id around_message_id window around_message_id window around_message_id)
                    (sqlite-records db
                      (str "SELECT m.id, m.role, m.content, m.timestamp FROM messages m "
                           "JOIN sessions s ON s.id = m.session_id WHERE s.id = ? AND " hidden-filter " AND " source-filter " "
                           "ORDER BY m.id DESC LIMIT ?")
                      session_id limit))

                  (not (str/blank? (or query "")))
                  (sqlite-records db
                    (str "SELECT s.id AS session_id, s.title, s.started_at, s.message_count, "
                         "m.id AS match_message_id, m.role, m.content, m.timestamp, "
                         "snippet(messages_fts, 0, '[', ']', ' … ', 16) AS snippet "
                         "FROM messages_fts JOIN messages m ON m.id = messages_fts.rowid "
                         "JOIN sessions s ON s.id = m.session_id WHERE messages_fts MATCH ? AND "
                         hidden-filter " AND " source-filter " AND m.role IN (" role-sql ") "
                         "ORDER BY bm25(messages_fts), m.id DESC LIMIT ?")
                    query limit)

                  :else
                  (sqlite-records db
                    (str "SELECT s.id AS session_id, s.title, s.started_at, s.message_count "
                         "FROM sessions s WHERE " hidden-filter " AND " source-filter " "
                         "ORDER BY COALESCE(s.last_activity_at, s.started_at) DESC LIMIT ?")
                    limit))
                result (if (and session_id (not around_message_id)) (vec (reverse result)) result)]
            (ok {"mode" (cond session_id (if around_message_id "scroll" "read")
                              (str/blank? (or query "")) "browse" :else "discover")
                 "profile" (:profile ctx)
                 "count" (count result)
                 "results" (mapv (fn [row]
                                   (cond-> row
                                     (contains? row "content") (update "content" #(clip (str %) 4000))))
                                 result)}))
          (finally (.close db)))))))

(defn- ha-tool [name]
  (fn [ctx args] (homeassistant/call ctx name args)))

(defn- kanban-env [ctx name]
  (or (get (:tool-env ctx) name) (h/env name)))

(defn- kanban-board-slug? [slug]
  (and (string? slug) (re-matches #"[a-z0-9][a-z0-9_-]{0,63}" slug)))

(defn- kanban-root [ctx]
  (let [override (kanban-env ctx "HERMES_KANBAN_HOME")
        hermes-home (some-> (kanban-env ctx "HERMES_HOME") h/expand)
        profile-home (:home ctx)
        profile-root (when (and profile-home (str/includes? profile-home "/.hermes/profiles/"))
                       (h/dirname (h/dirname profile-home)))]
    (h/expand (or override profile-root
                  (when hermes-home
                    (if (str/includes? hermes-home "/.hermes/profiles/")
                      (h/dirname (h/dirname hermes-home))
                      hermes-home))
                  (h/join (host-home ctx) ".hermes")))))

(defn- kanban-db-path [ctx args]
  (if-let [override (not-empty (kanban-env ctx "HERMES_KANBAN_DB"))]
    (h/expand override)
    (let [root (kanban-root ctx)
          explicit (get args "board")
          env-board (kanban-env ctx "HERMES_KANBAN_BOARD")
          current-file (h/join root "kanban" "current")
          current (when (h/file? current-file) (str/trim (h/slurp current-file)))
          current-dir (when (kanban-board-slug? current) (h/join root "kanban" "boards" current))
          current-exists? (and current-dir
                               (or (h/file? (h/join current-dir "board.json"))
                                   (h/file? (h/join current-dir "kanban.db"))))
          board (cond
                  (some? explicit) explicit
                  (not (str/blank? (str env-board))) env-board
                  current-exists? current
                  :else "default")]
      (when-not (kanban-board-slug? board)
        (throw (ex-info "invalid Kanban board slug" {:board board})))
      (if (= board "default")
        (h/join root "kanban.db")
        (h/join root "kanban" "boards" board "kanban.db")))))

(defn- redact-kanban-comment [body]
  ;; Comments are injected into later workers' context. Mirror Hermes' forced
  ;; redaction boundary for the common credential forms before persistence.
  (-> (str/trim body)
      (str/replace #"-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z ]*PRIVATE KEY-----"
                   "[REDACTED PRIVATE KEY]")
      (str/replace #"(?i)(\b(?:api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret|password|passwd|credential|authorization)\b\s*[:=]\s*)(?:\"[^\"]*\"|'[^']*'|[^\s,;]+)"
                   (fn [[_ prefix]] (str prefix "[REDACTED]")))
      (str/replace #"(?i)(\bbearer\s+)[A-Za-z0-9._~+/-]+=*"
                   (fn [[_ prefix]] (str prefix "[REDACTED]")))
      (str/replace #"\b(?:sk|pk|rk)-[A-Za-z0-9_-]{16,}|\bgh[pousr]_[A-Za-z0-9]{20,}|\bgithub_pat_[A-Za-z0-9_]{20,}|\bxox[abpr]-[A-Za-z0-9-]{10,}|\bAKIA[0-9A-Z]{16}\b"
                   "[REDACTED TOKEN]")
      (str/replace #"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}(?:\.[A-Za-z0-9_-]{10,})?\b"
                   "[REDACTED TOKEN]")
      (str/replace #"(?i)(://[^:/\s@]+:)[^@\s]+(@)"
                   (fn [[_ prefix suffix]] (str prefix "[REDACTED]" suffix)))))

(defn kanban-show
  "Read task state from the shared Hermes Kanban SQLite board."
  [ctx {:strs [task_id] :as args}]
  (if (:peer? ctx)
    (err "kanban_show is unavailable in peer runs; Kanban state is host-local")
    (let [task-id (or (not-empty task_id) (not-empty (kanban-env ctx "HERMES_KANBAN_TASK")))]
      (if-not task-id
        (err "kanban_show requires task_id outside a dispatcher task")
        (let [db-path (kanban-db-path ctx args)]
        (cond
          (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
          (h/symlink? db-path) (err "Kanban database path must not be a symlink")
          :else
          (let [db (sqlite/DatabaseSync. db-path)]
            (try
              (let [task (first (sqlite-records db "SELECT * FROM tasks WHERE id = ?" task-id))]
                (if-not task
                  (err (str "Kanban task not found: " task-id))
                  (let [parents (sqlite-records db "SELECT t.id, t.status FROM task_links l JOIN tasks t ON t.id = l.parent_id WHERE l.child_id = ? ORDER BY t.id" task-id)
                        children (sqlite-records db "SELECT child_id AS id FROM task_links WHERE parent_id = ? ORDER BY child_id" task-id)
                        comments (sqlite-records db "SELECT author, body, created_at FROM task_comments WHERE task_id = ? ORDER BY id" task-id)
                        events (vec (reverse (sqlite-records db "SELECT kind, payload, created_at, run_id FROM task_events WHERE task_id = ? ORDER BY id DESC LIMIT 50" task-id)))
                        runs (sqlite-records db "SELECT id, profile, status, outcome, summary, error, metadata, started_at, ended_at FROM task_runs WHERE task_id = ? ORDER BY id" task-id)
                        safe-task (select-keys task ["id" "title" "body" "assignee" "status" "tenant" "priority"
                                                     "workspace_kind" "workspace_path" "created_by" "created_at"
                                                     "started_at" "completed_at" "result" "current_run_id"
                                                     "model_override" "provider_override" "completion_contract"
                                                     "last_failure_error"])
                        context (str "Task " task-id ": " (get task "title") "\n"
                                     (or (get task "body") "")
                                     (when (seq comments)
                                       (str "\n\nComments:\n"
                                            (str/join "\n" (map #(str "- " (get % "author") ": " (redact-kanban-comment (get % "body"))) comments)))))
                        safe-comments (mapv #(update % "body" redact-kanban-comment) comments)]
                    (h/json-str {"task" safe-task
                                 "parents" (mapv #(get % "id") parents)
                                 "unsatisfied_parents" (filterv #(not (contains? #{"done" "archived"} (get % "status"))) parents)
                                 "children" (mapv #(get % "id") children)
                                 "comments" safe-comments
                                 "events" events
                                 "runs" runs
                                 "worker_context" context}))))
              (catch :default e (err (str "kanban_show: " (.-message e))))
              (finally (.close db))))))))))

(def ^:private kanban-resume-events
  "blocked block_loop_detected dependency_wait gave_up unblocked changes_requested review_reopened status reclaimed stale timed_out crashed spawn_failed rate_limited")

(defn- kanban-event-payload [row]
  (when-let [payload (get row "payload")]
    (try (h/json-parse payload) (catch :default _ {}))))

(defn- kanban-sticky-block? [db task-id]
  (let [last-block (first (sqlite-records db
                            "SELECT kind FROM task_events WHERE task_id = ? AND kind IN ('blocked', 'unblocked') ORDER BY id DESC LIMIT 1"
                            task-id))
        unblocked-id (or (some-> (first (sqlite-records db
                                      "SELECT MAX(id) AS id FROM task_events WHERE task_id = ? AND kind = 'unblocked'"
                                      task-id)) (get "id")) 0)
        gave-up (first (sqlite-records db
                       "SELECT payload FROM task_events WHERE task_id = ? AND kind = 'gave_up' AND id > ? ORDER BY id DESC LIMIT 1"
                       task-id unblocked-id))]
    (or (= "blocked" (get last-block "kind"))
        (true? (get (kanban-event-payload gave-up) "sticky")))))

(defn- kanban-resume-status [db task-id]
  (let [row (first (apply sqlite-records db
                   (str "SELECT payload FROM task_events WHERE task_id = ? AND kind IN ("
                        (str/join "," (repeat (count (str/split kanban-resume-events #" ")) "?"))
                        ") ORDER BY id DESC LIMIT 1")
                   (into [task-id] (str/split kanban-resume-events #" "))))
        payload (kanban-event-payload row)]
    (if (some #(= "review" (get payload %)) ["resume_status" "retry_status" "source_status"])
      "review" "ready")))

(defn- kanban-recompute-ready! [ctx db]
  (let [failure-limit (or (get-in ctx [:config "kanban" "failure_limit"]) 2)
        promoted (atom 0)]
    (.exec db "BEGIN IMMEDIATE")
    (try
      (doseq [row (sqlite-records db "SELECT id, status, consecutive_failures, max_retries FROM tasks WHERE status IN ('todo', 'blocked')")
              :let [task-id (get row "id")
                    status (get row "status")
                    parents (sqlite-records db "SELECT t.status FROM tasks t JOIN task_links l ON l.parent_id = t.id WHERE l.child_id = ?" task-id)
                    satisfied? (every? #(contains? #{"done" "archived"} (get % "status")) parents)
                    sticky? (and (= status "blocked") (kanban-sticky-block? db task-id))
                    effective-limit (or (get row "max_retries") failure-limit)]
              :when (and satisfied? (not sticky?)
                         (or (= status "todo") (< (or (get row "consecutive_failures") 0) effective-limit)))]
        (let [resume (kanban-resume-status db task-id)
              timestamp (js/Math.floor (/ (h/now-ms) 1000))
              payload (when (= resume "review") (h/json-str {"status" resume}))]
          (.run (.prepare db "UPDATE tasks SET status = ? WHERE id = ? AND status = ?") resume task-id status)
          (.run (.prepare db "INSERT INTO task_events (task_id, kind, payload, created_at) VALUES (?, 'promoted', ?, ?)")
                task-id payload timestamp)
          (swap! promoted inc)))
      (.exec db "COMMIT")
      @promoted
      (catch :default e
        (try (.exec db "ROLLBACK") (catch :default _ nil))
        (throw e)))))

(defn kanban-list
  "List bounded Kanban task summaries from the shared Hermes board."
  [ctx {:strs [assignee status tenant include_archived limit] :as args}]
  (cond
    (:peer? ctx) (err "kanban_list is unavailable in peer runs; Kanban state is host-local")
    (kanban-env ctx "HERMES_KANBAN_TASK") (err "kanban_list is orchestrator-only; dispatcher workers may only inspect their assigned task")
    (and status (not (contains? #{"triage" "todo" "ready" "running" "blocked" "done" "archived"} status)))
    (err "status must be one of triage, todo, ready, running, blocked, done, archived")
    (and limit (or (not (number? limit)) (not= limit (js/Math.floor limit)) (< limit 1) (> limit 200)))
    (err "limit must be an integer from 1 to 200")
    :else
    (let [db-path (kanban-db-path ctx args)
          row-limit (or limit 50)]
      (cond
        (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
        (h/symlink? db-path) (err "Kanban database path must not be a symlink")
        :else
        (let [db (sqlite/DatabaseSync. db-path)]
          (try
            (let [promoted (kanban-recompute-ready! ctx db)
                  filters (cond-> []
                            assignee (conj ["assignee = ?" assignee])
                            status (conj ["status = ?" status])
                            tenant (conj ["tenant = ?" tenant])
                            (and (not (true? include_archived)) (not= status "archived"))
                            (conj ["status != 'archived'" nil]))
                  where (if (seq filters) (str " WHERE " (str/join " AND " (map first filters))) "")
                  params (mapv second (remove #(nil? (second %)) filters))
                  rows (apply sqlite-records db
                              (str "SELECT * FROM tasks" where " ORDER BY priority DESC, created_at ASC LIMIT ?")
                              (concat params [(inc row-limit)]))
                  truncated (> (count rows) row-limit)
                  tasks (mapv (fn [task]
                                (let [task-id (get task "id")
                                      parents (mapv #(get % "parent_id") (sqlite-records db "SELECT parent_id FROM task_links WHERE child_id = ? ORDER BY parent_id" task-id))
                                      children (mapv #(get % "child_id") (sqlite-records db "SELECT child_id FROM task_links WHERE parent_id = ? ORDER BY child_id" task-id))]
                                  (assoc (select-keys task ["id" "title" "assignee" "status" "priority" "tenant"
                                                            "workspace_kind" "workspace_path" "project_id" "created_by"
                                                            "created_at" "started_at" "completed_at" "current_run_id"
                                                            "model_override" "provider_override"])
                                         "parents" parents "children" children
                                         "parent_count" (count parents) "child_count" (count children))))
                              (take row-limit rows))]
              (h/json-str {"tasks" tasks "count" (count tasks) "limit" row-limit
                           "promoted" promoted
                           "truncated" truncated
                           "next_limit" (when (and truncated (< row-limit 200)) (min 200 (* row-limit 2)))}))
            (catch :default e (err (str "kanban_list: " (.-message e))))
            (finally (.close db))))))))

(defn kanban-heartbeat
  "Record a liveness event for a running Kanban task."
  [ctx {:strs [task_id note] :as args}]
  (let [task-id (or (not-empty task_id) (not-empty (kanban-env ctx "HERMES_KANBAN_TASK")))
        run-id (when (= task-id (kanban-env ctx "HERMES_KANBAN_TASK"))
                 (js/parseInt (kanban-env ctx "HERMES_KANBAN_RUN_ID") 10))
        claim-lock (kanban-env ctx "HERMES_KANBAN_CLAIM_LOCK")]
    (cond
      (:peer? ctx) (err "kanban_heartbeat is unavailable in peer runs; Kanban state is host-local")
      (not task-id) (err "kanban_heartbeat requires task_id outside a dispatcher task")
      :else
      (let [db-path (kanban-db-path ctx args)]
        (cond
          (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
          (h/symlink? db-path) (err "Kanban database path must not be a symlink")
          :else
          (let [db (sqlite/DatabaseSync. db-path)]
            (try
              (.exec db "BEGIN IMMEDIATE")
              (let [now (js/Math.floor (/ (h/now-ms) 1000))
                    raw-ttl (some-> (kanban-env ctx "HERMES_KANBAN_CLAIM_TTL_SECONDS") js/parseInt)
                    ttl (if (and raw-ttl (not (js/Number.isNaN raw-ttl))) raw-ttl 900)
                    claim-expires (+ now (max 1 ttl))]
                (when claim-lock
                  (let [claim-update (.run (.prepare db "UPDATE tasks SET claim_expires = ? WHERE id = ? AND status = 'running' AND claim_lock = ?")
                                           claim-expires task-id claim-lock)]
                    (when-not (= 1 (.-changes claim-update))
                      (throw (ex-info "could not heartbeat claim (claim ownership changed)" {})))
                    (let [claim-run (get (first (sqlite-records db "SELECT current_run_id FROM tasks WHERE id = ?" task-id)) "current_run_id")]
                      (when claim-run
                        (.run (.prepare db "UPDATE task_runs SET claim_expires = ? WHERE id = ? AND task_id = ?")
                              claim-expires claim-run task-id)))))
                (let [owned-run (when (and run-id (not (js/Number.isNaN run-id))) run-id)
                      sql (str "UPDATE tasks SET last_heartbeat_at = ? WHERE id = ? AND status = 'running'"
                               (when owned-run " AND current_run_id = ?"))
                      stmt (.prepare db sql)
                      updated (if owned-run
                                (.run stmt now task-id owned-run)
                                (.run stmt now task-id))]
                  (when-not (= 1 (.-changes updated))
                    (throw (ex-info "could not heartbeat task (unknown id, not running, or run ownership changed)" {})))
                  (let [current-run (or owned-run
                                        (get (first (sqlite-records db "SELECT current_run_id FROM tasks WHERE id = ?" task-id)) "current_run_id"))]
                    (when current-run
                      (.run (.prepare db "UPDATE task_runs SET last_heartbeat_at = ? WHERE id = ? AND task_id = ?")
                            now current-run task-id))
                    (.run (.prepare db "INSERT INTO task_events (task_id, run_id, kind, payload, created_at) VALUES (?, ?, 'heartbeat', ?, ?)")
                          task-id current-run (when-not (str/blank? note) (h/json-str {"note" note})) now))
                  (.exec db "COMMIT")
                  (ok {"task_id" task-id})))
              (catch :default e
                (try (.exec db "ROLLBACK") (catch :default _ nil))
                (err (str "kanban_heartbeat: " (.-message e))))
              (finally (.close db)))))))))

(defn kanban-complete
  "Complete an owned Kanban task and persist the run handoff atomically."
  [ctx {:strs [task_id summary result metadata created_cards artifacts] :as args}]
  (let [task-id (or (not-empty task_id) (not-empty (kanban-env ctx "HERMES_KANBAN_TASK")))
        scoped-task (kanban-env ctx "HERMES_KANBAN_TASK")
        raw-run (when (= task-id scoped-task) (kanban-env ctx "HERMES_KANBAN_RUN_ID"))
        run-id (when raw-run (js/parseInt raw-run 10))
        summary (when (string? summary) (redact-kanban-comment summary))
        result (when (string? result) (redact-kanban-comment result))
        metadata (when (map? metadata)
                   (try (h/json-parse (redact-kanban-comment (h/json-str metadata)))
                        (catch :default _ nil)))
        created-cards (if (sequential? created_cards) (vec (remove str/blank? (map str created_cards))) [])
        artifacts (if (sequential? artifacts) (vec (remove str/blank? (map str artifacts))) [])]
    (cond
      (:peer? ctx) (err "kanban_complete is unavailable in peer runs; Kanban state is host-local")
      (not task-id) (err "kanban_complete requires task_id outside a dispatcher task")
      (and scoped-task (not= scoped-task task-id)) (err "kanban_complete may only complete the assigned dispatcher task")
      (and raw-run (or (js/Number.isNaN run-id) (not (pos? run-id)))) (err "kanban_complete requires a valid dispatcher run id")
      (and (contains? args "metadata") (not (map? (get args "metadata")))) (err "metadata must be an object")
      (and created_cards (or (not (sequential? created_cards)) (some (complement string?) created_cards)))
      (err "created_cards must be an array of task ids")
      (and artifacts (or (not (sequential? artifacts)) (some (complement string?) artifacts)))
      (err "artifacts must be an array of file paths")
      (or (seq artifacts) (seq (get metadata "artifacts")))
      (err "kanban_complete cannot preserve artifact files yet; omit artifacts until Kotoba artifact storage is available")
      :else
      (let [db-path (kanban-db-path ctx args)]
        (cond
          (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
          (h/symlink? db-path) (err "Kanban database path must not be a symlink")
          :else
          (let [db (sqlite/DatabaseSync. db-path)]
            (try
              (.exec db "BEGIN IMMEDIATE")
              (let [task (first (sqlite-records db "SELECT status, result, current_run_id, claim_lock, created_at, assignee FROM tasks WHERE id = ?" task-id))
                    status (get task "status")
                    current-run (get task "current_run_id")
                    actual-summary (or (not-empty summary) (not-empty result) (not-empty (get task "result"))
                                       (when (= status "review") "Review approved without additional evidence."))
                    parents (sqlite-records db "SELECT t.id, t.status FROM task_links l JOIN tasks t ON t.id = l.parent_id WHERE l.child_id = ?" task-id)
                    unsatisfied (filterv #(not (contains? #{"done" "archived"} (get % "status"))) parents)
                    child-ids (set (map #(get % "child_id") (sqlite-records db "SELECT child_id FROM task_links WHERE parent_id = ?" task-id)))
                    created-missing (filterv (fn [id]
                                               (let [child (first (sqlite-records db "SELECT created_by FROM tasks WHERE id = ?" id))
                                                     creator (get child "created_by")]
                                                 (not (and child
                                                           (or (and creator
                                                                    (or (= creator (get task "assignee"))
                                                                        (= creator task-id)))
                                                               (contains? child-ids id))))))
                                             created-cards)]
                (when-not task (throw (ex-info (str "Kanban task not found: " task-id) {})))
                (when (seq unsatisfied)
                  (throw (ex-info (str "unsatisfied parent dependencies: "
                                       (str/join ", " (map #(str (get % "id") " (" (get % "status") ")") unsatisfied))) {})))
                (when (seq created-missing)
                  (throw (ex-info (str "created_cards do not exist: " (str/join ", " created-missing)) {})))
                (when-not (contains? #{"running" "ready" "blocked" "review"} status)
                  (throw (ex-info (str "task cannot be completed from status " status) {})))
                (when (and (= status "running") (or (nil? run-id) (not= run-id current-run)))
                  (throw (ex-info "running task completion requires the matching dispatcher run id" {})))
                (when (and (not= status "running") current-run)
                  (throw (ex-info "task has an active run but is not in running status" {})))
                (when (and (not= status "review") (str/blank? (or actual-summary "")))
                  (throw (ex-info "completion needs non-empty evidence in summary or result" {})))
                (let [now (js/Math.floor (/ (h/now-ms) 1000))
                      handoff (or (not-empty summary) (not-empty result))
                      metadata-json (when (and metadata (seq (js/Object.keys (clj->js metadata)))) (h/json-str metadata))
                      updated (.run (.prepare db
                                "UPDATE tasks SET status='done', result=?, completed_at=?, claim_lock=NULL, claim_expires=NULL, worker_pid=NULL, current_run_id=NULL, block_kind=NULL, block_recurrences=0, consecutive_failures=0, last_failure_error=NULL WHERE id=? AND status=? AND ((current_run_id IS NULL AND ? IS NULL) OR current_run_id=?)")
                                result now task-id status current-run current-run)]
                  (when-not (= 1 (.-changes updated))
                    (throw (ex-info "task status or run ownership changed before completion" {})))
                  (let [run-update (when current-run
                                     (.run (.prepare db "UPDATE task_runs SET status='done', outcome='completed', summary=?, error=NULL, metadata=?, ended_at=?, claim_expires=NULL WHERE id=? AND task_id=? AND ended_at IS NULL")
                                           (or handoff actual-summary) metadata-json now current-run task-id))]
                    (when (and current-run (not= 1 (.-changes run-update)))
                      (throw (ex-info "active task run was already closed" {}))))
                  (let [completed-run (or current-run
                                          (.-lastInsertRowid (.run (.prepare db "INSERT INTO task_runs (task_id, profile, status, outcome, summary, metadata, started_at, ended_at) VALUES (?, ?, 'done', 'completed', ?, ?, ?, ?)")
                                                                  task-id (or (get task "assignee") (:profile ctx))
                                                                  (or handoff actual-summary) metadata-json
                                                                  (or (get task "created_at") now) now)))
                        event-summary (or handoff actual-summary)
                        summary-line (first (str/split (str event-summary) #"\n"))
                        payload (h/json-str (cond-> {"result_len" (count (or result ""))
                                                     "summary" (when-not (str/blank? summary-line)
                                                                 (subs summary-line 0 (min 400 (count summary-line))))}
                                              (seq created-cards) (assoc "verified_cards" created-cards)))]
                    (.run (.prepare db "INSERT INTO task_events (task_id, run_id, kind, payload, created_at) VALUES (?, ?, 'completed', ?, ?)")
                          task-id completed-run payload now)
                    (.exec db "COMMIT")
                    (try (kanban-recompute-ready! ctx db) (catch :default _ nil))
                    (ok {"task_id" task-id "status" "done" "run_id" completed-run}))))
              (catch :default e
                (try (.exec db "ROLLBACK") (catch :default _ nil))
                (err (str "kanban_complete: " (.-message e))))
              (finally (.close db)))))))))

(defn kanban-block
  "Route an owned Kanban worker run to a blocked or dependency-wait state."
  [ctx {:strs [task_id reason kind] :as args}]
  (let [task-id (or (not-empty task_id) (not-empty (kanban-env ctx "HERMES_KANBAN_TASK")))
        scoped-task (kanban-env ctx "HERMES_KANBAN_TASK")
        raw-run (when (= task-id scoped-task) (kanban-env ctx "HERMES_KANBAN_RUN_ID"))
        run-id (when raw-run (js/parseInt raw-run 10))
        reason (when (string? reason) (redact-kanban-comment reason))
        allowed-kinds #{"dependency" "needs_input" "capability" "transient"}]
    (cond
      (:peer? ctx) (err "kanban_block is unavailable in peer runs; Kanban state is host-local")
      (not task-id) (err "kanban_block requires task_id outside a dispatcher task")
      (and scoped-task (not= scoped-task task-id)) (err "kanban_block may only block the assigned dispatcher task")
      (or (not (string? reason)) (str/blank? reason)) (err "reason is required; explain what stopped the task")
      (and kind (not (contains? allowed-kinds kind))) (err "kind must be dependency, needs_input, capability, or transient")
      (and raw-run (or (js/Number.isNaN run-id) (not (pos? run-id)))) (err "kanban_block requires a valid dispatcher run id")
      :else
      (let [db-path (kanban-db-path ctx args)]
        (cond
          (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
          (h/symlink? db-path) (err "Kanban database path must not be a symlink")
          :else
          (let [db (sqlite/DatabaseSync. db-path)]
            (try
              (.exec db "BEGIN IMMEDIATE")
              (let [task (first (sqlite-records db "SELECT status, block_kind, block_recurrences, current_run_id, goal_mode FROM tasks WHERE id = ?" task-id))
                    status (get task "status")
                    current-run (get task "current_run_id")
                    parent-rows (sqlite-records db "SELECT t.status FROM task_links l JOIN tasks t ON t.id = l.parent_id WHERE l.child_id = ?" task-id)
                    parents-satisfied? (every? #(contains? #{"done" "archived"} (get % "status")) parent-rows)
                    requested-kind kind
                    kind (if (and (= kind "dependency") parents-satisfied?) "needs_input" kind)
                    source-status (if (= status "running")
                                    (let [claimed (first (sqlite-records db "SELECT payload FROM task_events WHERE task_id = ? AND run_id = ? AND kind = 'claimed' ORDER BY id DESC LIMIT 1" task-id current-run))
                                          payload (kanban-event-payload claimed)]
                                      (if (= "review" (get payload "source_status")) "review" "ready"))
                                    "ready")]
                (when-not task (throw (ex-info (str "Kanban task not found: " task-id) {})))
                (when (and (= 1 (get task "goal_mode")) (not (contains? #{"dependency" "needs_input"} kind)))
                  (throw (ex-info "goal_mode tasks may only block with kind dependency or needs_input" {})))
                (if (= status "blocked")
                  (do
                    (when (or (nil? kind) raw-run (some? (get task "block_kind")) current-run)
                      (throw (ex-info "blocked task cannot be reclassified by this worker" {})))
                    (let [classified (.run (.prepare db "UPDATE tasks SET block_kind = ?, block_recurrences = 1 WHERE id = ? AND status = 'blocked' AND block_kind IS NULL AND current_run_id IS NULL")
                                            kind task-id)]
                      (when-not (= 1 (.-changes classified))
                        (throw (ex-info "blocked task changed before reclassification" {}))))
                    (.run (.prepare db "INSERT INTO task_events (task_id, kind, payload, created_at) VALUES (?, 'blocked', ?, ?)")
                          task-id (h/json-str {"kind" kind "reason" reason "classified_in_place" true})
                          (js/Math.floor (/ (h/now-ms) 1000)))
                    (.exec db "COMMIT")
                    (ok {"task_id" task-id "status" "blocked" "block_kind" kind "classified_in_place" true}))
                  (do
                    (when-not (contains? #{"running" "ready"} status)
                      (throw (ex-info (str "could not block task from status " status) {})))
                    (when (and (= status "running") (or (nil? run-id) (not= run-id current-run)))
                      (throw (ex-info "running task block requires the matching dispatcher run id" {})))
                    (let [recurrences (if (= (get task "block_kind") kind)
                                        (inc (or (get task "block_recurrences") 0)) 1)
                          dependency? (= "dependency" kind)
                          escalate? (and (not dependency?) (>= recurrences 2))
                          new-status (cond dependency? "todo" escalate? "triage" :else "blocked")
                          event-kind (cond dependency? "dependency_wait" escalate? "block_loop_detected" :else "blocked")
                          payload (cond-> {"reason" reason "kind" kind "source_status" source-status}
                                    (not dependency?) (assoc "recurrences" recurrences)
                                    escalate? (assoc "limit" 2)
                                    (and (= requested-kind "dependency") (not= kind requested-kind))
                                    (assoc "requested_kind" requested-kind "rekind_reason" "no_open_parent"))
                          now (js/Math.floor (/ (h/now-ms) 1000))
                          updated (.run (.prepare db "UPDATE tasks SET status=?, claim_lock=NULL, claim_expires=NULL, worker_pid=NULL, block_kind=?, block_recurrences=? WHERE id=? AND status=? AND ((current_run_id IS NULL AND ? IS NULL) OR current_run_id=?)")
                                        new-status kind (if dependency? (get task "block_recurrences") recurrences)
                                        task-id status current-run current-run)]
                      (when-not (= 1 (.-changes updated))
                        (throw (ex-info "task status or run ownership changed before block" {})))
                      (when current-run
                        (let [ended (.run (.prepare db "UPDATE task_runs SET status='blocked', outcome='blocked', summary=?, ended_at=?, claim_expires=NULL WHERE id=? AND task_id=? AND ended_at IS NULL")
                                          reason now current-run task-id)]
                          (when-not (= 1 (.-changes ended))
                            (throw (ex-info "active task run was already closed" {})))))
                      (.run (.prepare db "UPDATE tasks SET current_run_id=NULL WHERE id=?") task-id)
                      (.run (.prepare db "INSERT INTO task_events (task_id, run_id, kind, payload, created_at) VALUES (?, ?, ?, ?, ?)")
                            task-id current-run event-kind (h/json-str payload) now)
                      (.exec db "COMMIT")
                      (ok {"task_id" task-id "status" new-status "block_kind" kind})))))
              (catch :default e
                (try (.exec db "ROLLBACK") (catch :default _ nil))
                (err (str "kanban_block: " (.-message e))))
              (finally (.close db)))))))))

(defn kanban-request-review
  "Hand an implementation to the reviewer, preserving implementer provenance."
  [ctx {:strs [task_id summary metadata reviewer artifacts] :as args}]
  (let [task-id (or (not-empty task_id) (not-empty (kanban-env ctx "HERMES_KANBAN_TASK")))
        scoped-task (kanban-env ctx "HERMES_KANBAN_TASK")
        raw-run (when (= task-id scoped-task) (kanban-env ctx "HERMES_KANBAN_RUN_ID"))
        run-id (when raw-run (js/parseInt raw-run 10))
        summary (when (string? summary) (redact-kanban-comment summary))
        reviewer (when (and (string? reviewer) (not (str/blank? reviewer))) (redact-kanban-comment reviewer))
        metadata (when (map? metadata)
                   (try (h/json-parse (redact-kanban-comment (h/json-str metadata)))
                        (catch :default _ nil)))
        artifacts (or artifacts [])]
    (cond
      (:peer? ctx) (err "kanban_request_review is unavailable in peer runs; Kanban state is host-local")
      (not task-id) (err "kanban_request_review requires task_id outside a dispatcher task")
      (and scoped-task (not= scoped-task task-id)) (err "kanban_request_review may only hand off the assigned dispatcher task")
      (or (not (string? summary)) (str/blank? summary)) (err "summary is required")
      (and metadata (not (map? metadata))) (err "metadata must be an object")
      (and (some? artifacts) (not (sequential? artifacts))) (err "artifacts must be an array of file paths")
      (and (sequential? artifacts) (some (complement string?) artifacts)) (err "artifacts must be an array of file paths")
      (seq artifacts)
      (err "kanban_request_review cannot preserve artifact files yet; omit artifacts until Kotoba artifact storage is available")
      (seq (get metadata "artifacts"))
      (err "kanban_request_review cannot preserve metadata.artifacts yet; omit artifacts until Kotoba artifact storage is available")
      (and raw-run (or (js/Number.isNaN run-id) (not (pos? run-id)))) (err "kanban_request_review requires a valid dispatcher run id")
      (and reviewer (not (or (= reviewer "default") (some #{reviewer} (profile/names)))) )
      (err (str "reviewer profile " reviewer " is not installed"))
      :else
      (let [db-path (kanban-db-path ctx args)]
        (cond
          (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
          (h/symlink? db-path) (err "Kanban database path must not be a symlink")
          :else
          (let [db (sqlite/DatabaseSync. db-path)]
            (try
              (.exec db "BEGIN IMMEDIATE")
              (let [task (first (sqlite-records db "SELECT status, assignee, current_run_id FROM tasks WHERE id = ?" task-id))
                    status (get task "status")
                    current-run (get task "current_run_id")
                    parents (sqlite-records db "SELECT t.status FROM task_links l JOIN tasks t ON t.id = l.parent_id WHERE l.child_id = ?" task-id)
                    parents-satisfied? (every? #(contains? #{"done" "archived"} (get % "status")) parents)]
                (when-not task (throw (ex-info (str "Kanban task not found: " task-id) {})))
                (when-not (contains? #{"running" "ready"} status)
                  (throw (ex-info (str "could not request review from status " status) {})))
                (when-not parents-satisfied? (throw (ex-info "parent dependencies are not satisfied" {})))
                (when (and (= status "running") (or (nil? run-id) (not= run-id current-run)))
                  (throw (ex-info "running task review requires the matching dispatcher run id" {})))
                (when (and (not= status "running") current-run)
                  (throw (ex-info "task has an active run but is not in running status" {})))
                (let [run-profile (when current-run
                                    (get (first (sqlite-records db "SELECT profile FROM task_runs WHERE id = ?" current-run)) "profile"))
                      implementer (or run-profile
                                      (when (not= reviewer (get task "assignee")) (get task "assignee")))
                      prior (first (sqlite-records db "SELECT payload FROM task_events WHERE task_id = ? AND kind = 'changes_requested' ORDER BY id DESC LIMIT 1" task-id))
                      prior-reviewer (get (kanban-event-payload prior) "reviewer")
                      reviewer (or reviewer (when (and (string? prior-reviewer) (not (str/blank? prior-reviewer))) prior-reviewer))
                      now (js/Math.floor (/ (h/now-ms) 1000))
                      metadata-json (when (and metadata (seq (js/Object.keys (clj->js metadata)))) (h/json-str metadata))
                      upd (.run (.prepare db "UPDATE tasks SET status='review', assignee=COALESCE(?, assignee), claim_lock=NULL, claim_expires=NULL, worker_pid=NULL, current_run_id=NULL WHERE id=? AND status=? AND ((current_run_id IS NULL AND ? IS NULL) OR current_run_id=?)")
                                reviewer task-id status current-run current-run)]
                  (when-not (= 1 (.-changes upd)) (throw (ex-info "task changed during review handoff" {})))
                  (let [event-run (if current-run
                                    current-run
                                    (when (or (seq summary) metadata)
                                      (.-lastInsertRowid (.run (.prepare db "INSERT INTO task_runs (task_id, profile, status, outcome, summary, metadata, started_at, ended_at) VALUES (?, ?, 'review', 'review_requested', ?, ?, ?, ?)")
                                                                task-id (or implementer reviewer (get task "assignee") (:profile ctx)) summary metadata-json now now))))]
                  (if current-run
                    (let [ended (.run (.prepare db "UPDATE task_runs SET status='review', outcome='review_requested', summary=?, metadata=?, ended_at=?, claim_expires=NULL WHERE id=? AND task_id=? AND ended_at IS NULL")
                                       summary metadata-json now current-run task-id)]
                      (when-not (= 1 (.-changes ended)) (throw (ex-info "active task run was already closed" {}))))
                  (.run (.prepare db "INSERT INTO task_events (task_id, run_id, kind, payload, created_at) VALUES (?, ?, 'review_requested', ?, ?)")
                        task-id event-run (h/json-str {"summary" (first (str/split summary #"\n")) "implementer" implementer "reviewer" reviewer}) now)))
                  (.exec db "COMMIT")
                  (ok {"task_id" task-id "status" "review" "reviewer" reviewer})))
              (catch :default e
                (try (.exec db "ROLLBACK") (catch :default _ nil))
                (err (str "kanban_request_review: " (.-message e))))
              (finally (.close db)))))))))

(defn kanban-request-changes
  "Return an active reviewer run to the implementer recorded on its handoff."
  [ctx {:strs [task_id reason] :as args}]
  (let [task-id (or (not-empty task_id) (not-empty (kanban-env ctx "HERMES_KANBAN_TASK")))
        scoped-task (kanban-env ctx "HERMES_KANBAN_TASK")
        raw-run (when (= task-id scoped-task) (kanban-env ctx "HERMES_KANBAN_RUN_ID"))
        run-id (when raw-run (js/parseInt raw-run 10))
        reason (when (string? reason) (redact-kanban-comment reason))]
    (cond
      (:peer? ctx) (err "kanban_request_changes is unavailable in peer runs; Kanban state is host-local")
      (not task-id) (err "kanban_request_changes requires task_id outside a dispatcher task")
      (and scoped-task (not= scoped-task task-id)) (err "kanban_request_changes may only return the assigned dispatcher task")
      (or (not (string? reason)) (str/blank? reason)) (err "reason is required")
      (and raw-run (or (js/Number.isNaN run-id) (not (pos? run-id)))) (err "kanban_request_changes requires a valid dispatcher run id")
      :else
      (let [db-path (kanban-db-path ctx args)]
        (cond
          (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
          (h/symlink? db-path) (err "Kanban database path must not be a symlink")
          :else
          (let [db (sqlite/DatabaseSync. db-path)]
            (try
              (.exec db "BEGIN IMMEDIATE")
              (let [task (first (sqlite-records db "SELECT status, assignee, current_run_id FROM tasks WHERE id = ?" task-id))
                    current-run (get task "current_run_id")
                    claimed (first (sqlite-records db "SELECT payload FROM task_events WHERE task_id = ? AND run_id = ? AND kind = 'claimed' ORDER BY id DESC LIMIT 1" task-id current-run))
                    requested (first (sqlite-records db "SELECT payload FROM task_events WHERE task_id = ? AND kind = 'review_requested' ORDER BY id DESC LIMIT 1" task-id))
                    claim-payload (kanban-event-payload claimed)
                    review-payload (kanban-event-payload requested)
                    implementer (get review-payload "implementer")
                    parents (sqlite-records db "SELECT t.status FROM task_links l JOIN tasks t ON t.id = l.parent_id WHERE l.child_id = ?" task-id)
                    landing (if (every? #(contains? #{"done" "archived"} (get % "status")) parents) "ready" "todo")]
                (when-not task (throw (ex-info (str "Kanban task not found: " task-id) {})))
                (when-not (and (= "running" (get task "status")) current-run)
                  (throw (ex-info "task is not in an active review run" {})))
                (when (and raw-run (not= run-id current-run)) (throw (ex-info "run_id mismatch" {})))
                (when-not (= "review" (get claim-payload "source_status"))
                  (throw (ex-info "active run was not claimed from review" {})))
                (when-not (and (string? implementer) (not (str/blank? implementer)))
                  (throw (ex-info "review handoff has no valid implementer provenance" {})))
                (let [now (js/Math.floor (/ (h/now-ms) 1000))
                      upd (.run (.prepare db "UPDATE tasks SET status=?, assignee=?, claim_lock=NULL, claim_expires=NULL, worker_pid=NULL, worker_started_at=NULL, current_run_id=NULL WHERE id=? AND status='running' AND current_run_id=?")
                                landing implementer task-id current-run)]
                  (when-not (= 1 (.-changes upd)) (throw (ex-info "task changed during review handoff" {})))
                  (.run (.prepare db "UPDATE task_runs SET status='done', outcome='changes_requested', summary=?, ended_at=?, claim_expires=NULL WHERE id=? AND task_id=? AND ended_at IS NULL")
                        reason now current-run task-id)
                  (.run (.prepare db "INSERT INTO task_events (task_id, run_id, kind, payload, created_at) VALUES (?, ?, 'changes_requested', ?, ?)")
                        task-id current-run (h/json-str {"reason" reason "implementer" implementer "reviewer" (get task "assignee") "status" landing}) now)
                  (.exec db "COMMIT")
                  (ok {"task_id" task-id "status" landing "implementer" implementer})))
              (catch :default e
                (try (.exec db "ROLLBACK") (catch :default _ nil))
                (err (str "kanban_request_changes: " (.-message e))))
              (finally (.close db)))))))))

(defn kanban-create
  "Create an assigned Kanban task with dependency, idempotency, and retry metadata."
  [ctx {:strs [title assignee body parents tenant priority workspace_kind workspace_path project triage
               idempotency_key max_runtime_seconds initial_status skills goal_mode goal_max_turns
               completion_contract model provider] :as args}]
  (let [scoped-task (kanban-env ctx "HERMES_KANBAN_TASK")
        parents (or parents [])
        workspace-kind (or workspace_kind "scratch")
        initial-status (or initial_status "running")
        tenant (or tenant (kanban-env ctx "HERMES_TENANT"))
        priority (or priority 0)
        skills (or skills [])
        goal-mode (boolean goal_mode)
        contract (or completion_contract "local-only")]
    (cond
      (:peer? ctx) (err "kanban_create is unavailable in peer runs; Kanban state is host-local")
      scoped-task (err "kanban_create is orchestrator-only; dispatcher workers cannot create sibling tasks")
      (or (not (string? title)) (str/blank? title)) (err "title is required")
      (or (not (string? assignee)) (str/blank? assignee)) (err "assignee is required")
      (not (or (= assignee "default") (some #{assignee} (profile/names)))) (err (str "assignee profile " assignee " is not installed"))
      (and (some? body) (not (string? body))) (err "body must be a string")
      (and (some? tenant) (not (string? tenant))) (err "tenant must be a string")
      (and (some? idempotency_key) (not (string? idempotency_key))) (err "idempotency_key must be a string")
      (and (some? triage) (not (boolean? triage))) (err "triage must be a boolean")
      (and (some? goal_mode) (not (boolean? goal_mode))) (err "goal_mode must be a boolean")
      (and (some? model) (not (string? model))) (err "model must be a string")
      (and (some? provider) (not (string? provider))) (err "provider must be a string")
      (not (sequential? parents)) (err "parents must be an array of task ids")
      (some (complement string?) parents) (err "parents must be an array of task ids")
      (not (contains? #{"scratch" "dir" "worktree"} workspace-kind)) (err "workspace_kind must be scratch, dir, or worktree")
      (and (contains? #{"dir" "worktree"} workspace-kind) (some? workspace_path)
           (not (and (string? workspace_path) (str/starts-with? workspace_path "/")))) (err "workspace_path must be an absolute path")
      (and (= "dir" workspace-kind) (not (and (string? workspace_path) (str/starts-with? workspace_path "/"))))
      (err "workspace_kind 'dir' requires an absolute workspace_path")
      (and project (not (str/blank? project))) (err "project-linked worktrees are not supported by Kotoba Kanban yet; omit project")
      (not (contains? #{"running" "blocked"} initial-status)) (err "initial_status must be running or blocked")
      (or (not (number? priority)) (not= priority (js/Math.floor priority))) (err "priority must be an integer")
      (and (some? max_runtime_seconds) (or (not (number? max_runtime_seconds)) (not= max_runtime_seconds (js/Math.floor max_runtime_seconds)) (< max_runtime_seconds 1)))
      (err "max_runtime_seconds must be a positive integer")
      (not (sequential? skills)) (err "skills must be an array of skill names")
      (some (complement string?) skills) (err "skills must be an array of skill names")
      (and (some? goal_max_turns) (or (not (number? goal_max_turns)) (not= goal_max_turns (js/Math.floor goal_max_turns)) (< goal_max_turns 1)))
      (err "goal_max_turns must be a positive integer")
      (and (some? completion_contract)
           (not (or (= contract "local-only")
                    (re-matches #"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+" contract)
                    (re-matches #"https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*" contract))))
      (err "completion_contract must be local-only, OWNER/REPO, or an exact GitHub PR URL")
      (and provider (not model)) (err "provider requires model to be set as well")
      :else
      (let [db-path (kanban-db-path ctx args)]
        (cond
          (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
          (h/symlink? db-path) (err "Kanban database path must not be a symlink")
          :else
          (let [db (sqlite/DatabaseSync. db-path)]
            (try
              (.exec db "BEGIN IMMEDIATE")
              (let [existing (when (and idempotency_key (not (str/blank? idempotency_key)))
                               (first (sqlite-records db "SELECT id FROM tasks WHERE idempotency_key=? AND status!='archived' ORDER BY created_at DESC LIMIT 1" idempotency_key)))]
                (if existing
                  (do (.exec db "COMMIT") (ok {"task_id" (get existing "id") "idempotent_reuse" true}))
                  (let [parent-rows (if (seq parents)
                                      (let [marks (str/join "," (repeat (count parents) "?"))]
                                        (apply sqlite-records db (str "SELECT id, status, tenant FROM tasks WHERE id IN (" marks ")") parents))
                                      [])
                        parent-by-id (into {} (map (juxt #(get % "id") identity) parent-rows))
                        missing (filterv #(not (contains? parent-by-id %)) parents)]
                    (when (seq missing) (throw (ex-info (str "unknown parent task(s): " (str/join ", " missing)) {})))
                    (let [tenant (or tenant (some #(get-in parent-by-id [% "tenant"]) parents))
                          gating-parent (first (filter #(not (contains? #{"done" "archived"} (get-in parent-by-id [% "status"]))) parents))
                          status (cond (= "blocked" initial-status) "blocked"
                                       (true? (get args "triage")) "triage"
                                       gating-parent "todo"
                                       :else "ready")
                          now (js/Math.floor (/ (h/now-ms) 1000))
                          task-id (str "t_" (.toString (.randomBytes crypto 4) "hex"))
                          workspace-path (when (and (string? workspace_path) (not (str/blank? workspace_path))) workspace_path)
                          skill-json (when (seq skills) (h/json-str (vec skills)))
                          inserted (.run (.prepare db "INSERT INTO tasks (id,title,body,assignee,status,priority,created_by,created_at,workspace_kind,workspace_path,tenant,idempotency_key,max_runtime_seconds,skills,model_override,provider_override,goal_mode,goal_max_turns,completion_contract) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)")
                                           task-id (str/trim title) body assignee status priority (:profile ctx) now workspace-kind workspace-path tenant idempotency_key max_runtime_seconds skill-json model provider (if goal-mode 1 0) goal_max_turns contract)]
                      (when-not (= 1 (.-changes inserted)) (throw (ex-info "Kanban task insert failed" {})))
                      (doseq [parent-id parents]
                        (.run (.prepare db "INSERT OR IGNORE INTO task_links (parent_id, child_id) VALUES (?, ?)") parent-id task-id))
                      (.run (.prepare db "INSERT INTO task_events (task_id,kind,payload,created_at) VALUES (?,'created',?,?)")
                            task-id (h/json-str {"assignee" assignee "status" status "parents" (vec parents)
                                                "tenant" tenant "workspace_kind" workspace-kind
                                                "workspace_path" workspace-path "skills" (when (seq skills) (vec skills))
                                                "goal_mode" goal-mode "goal_max_turns" goal_max_turns
                                                "model_override" model "provider_override" provider
                                                "max_runtime_seconds" max_runtime_seconds "priority" priority
                                                "completion_contract" contract "idempotency_key" idempotency_key}) now)
                      (when (= status "blocked")
                        (.run (.prepare db "INSERT INTO task_events (task_id,kind,payload,created_at) VALUES (?,'blocked',?,?)")
                              task-id (h/json-str {"reason" "initial_status" "status" "blocked" "actor" (:profile ctx)}) now))
                      (when (and (= status "todo") gating-parent)
                        (.run (.prepare db "INSERT INTO task_events (task_id,kind,payload,created_at) VALUES (?,'dependency_wait',?,?)")
                              task-id (h/json-str {"reason" "parent_not_done" "parent" gating-parent}) now))
                      (.exec db "COMMIT")
                      (ok {"task_id" task-id "status" status "gated" (boolean gating-parent)})))))
              (catch :default e
                (try (.exec db "ROLLBACK") (catch :default _ nil))
                (err (str "kanban_create: " (.-message e))))
              (finally (.close db)))))))))

(defn kanban-link
  "Add a dependency edge and demote an unstarted ready child when needed."
  [ctx {:strs [parent_id child_id] :as args}]
  (let [scoped-task (kanban-env ctx "HERMES_KANBAN_TASK")
        raw-run (when (= child_id scoped-task) (kanban-env ctx "HERMES_KANBAN_RUN_ID"))
        run-id (when raw-run (js/parseInt raw-run 10))]
    (cond
      (:peer? ctx) (err "kanban_link is unavailable in peer runs; Kanban state is host-local")
      (or (not (string? parent_id)) (str/blank? parent_id)
          (not (string? child_id)) (str/blank? child_id)) (err "parent_id and child_id are required")
      (= parent_id child_id) (err "a task cannot depend on itself")
      (and raw-run (or (js/Number.isNaN run-id) (not (pos? run-id)))) (err "kanban_link requires a valid dispatcher run id")
      :else
      (let [db-path (kanban-db-path ctx args)]
        (cond
          (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
          (h/symlink? db-path) (err "Kanban database path must not be a symlink")
          :else
          (let [db (sqlite/DatabaseSync. db-path)]
            (try
              (.exec db "BEGIN IMMEDIATE")
              (let [parent (first (sqlite-records db "SELECT status FROM tasks WHERE id = ?" parent_id))
                    child (first (sqlite-records db "SELECT status, current_run_id FROM tasks WHERE id = ?" child_id))]
                (when-not parent (throw (ex-info (str "unknown task: " parent_id) {})))
                (when-not child (throw (ex-info (str "unknown task: " child_id) {})))
                (when (and (= "running" (get child "status"))
                           (or (not= child_id scoped-task) (not= run-id (get child "current_run_id"))))
                  (throw (ex-info (str "cannot link " parent_id " -> " child_id ": child is already running") {})))
                (let [cycle (first (sqlite-records db
                                  "WITH RECURSIVE descendants(id) AS (SELECT child_id FROM task_links WHERE parent_id = ? UNION SELECT l.child_id FROM task_links l JOIN descendants d ON l.parent_id = d.id) SELECT 1 AS cycle FROM descendants WHERE id = ? LIMIT 1"
                                  child_id parent_id))]
                  (when cycle (throw (ex-info (str "linking " parent_id " -> " child_id " would create a cycle") {}))))
                (.run (.prepare db "INSERT OR IGNORE INTO task_links (parent_id, child_id) VALUES (?, ?)") parent_id child_id)
                (let [gated? (and (not (contains? #{"done" "archived"} (get parent "status")))
                                  (= "ready" (get child "status")))
                      now (js/Math.floor (/ (h/now-ms) 1000))]
                  (when gated?
                    (.run (.prepare db "UPDATE tasks SET status='todo' WHERE id=? AND status='ready'") child_id)
                    (.run (.prepare db "INSERT INTO task_events (task_id, kind, payload, created_at) VALUES (?, 'dependency_wait', ?, ?)")
                          child_id (h/json-str {"reason" "parent_not_done" "demoted" true "parent" parent_id}) now))
                  (.run (.prepare db "INSERT INTO task_events (task_id, kind, payload, created_at) VALUES (?, 'linked', ?, ?)")
                        child_id (h/json-str {"parent" parent_id "child" child_id}) now)
                  (.exec db "COMMIT")
                  (ok (cond-> {"parent_id" parent_id "child_id" child_id "gated" (boolean gated?)}
                        gated? (assoc "gated_by" parent_id)))))
              (catch :default e
                (try (.exec db "ROLLBACK") (catch :default _ nil))
                (err (str "kanban_link: " (.-message e))))
              (finally (.close db)))))))))

(defn kanban-unblock
  "Restore a blocked task to its resumable state with parent gating applied."
  [ctx {:strs [task_id] :as args}]
  (let [scoped-task (kanban-env ctx "HERMES_KANBAN_TASK")]
    (cond
      (:peer? ctx) (err "kanban_unblock is unavailable in peer runs; Kanban state is host-local")
      scoped-task (err "kanban_unblock is orchestrator-only; dispatcher workers cannot unblock tasks")
      (or (not (string? task_id)) (str/blank? task_id)) (err "task_id is required")
      :else
      (let [db-path (kanban-db-path ctx args)]
        (cond
          (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
          (h/symlink? db-path) (err "Kanban database path must not be a symlink")
          :else
          (let [db (sqlite/DatabaseSync. db-path)]
            (try
              (.exec db "BEGIN IMMEDIATE")
              (let [task (first (sqlite-records db "SELECT status, current_run_id FROM tasks WHERE id = ?" task_id))
                    parents (sqlite-records db "SELECT t.status FROM task_links l JOIN tasks t ON t.id = l.parent_id WHERE l.child_id = ?" task_id)
                    satisfied? (every? #(contains? #{"done" "archived"} (get % "status")) parents)
                    resume (kanban-resume-status db task_id)
                    next-status (if satisfied? (if (= resume "review") "review" "ready") "todo")]
                (when-not task (throw (ex-info (str "Kanban task not found: " task_id) {})))
                (when-not (= "blocked" (get task "status"))
                  (throw (ex-info "task is not blocked" {})))
                (when (get task "current_run_id")
                  (throw (ex-info "blocked task still has an active run; recover the run before unblocking" {})))
                (let [now (js/Math.floor (/ (h/now-ms) 1000))
                      updated (.run (.prepare db "UPDATE tasks SET status=?, claim_lock=NULL, claim_expires=NULL, worker_pid=NULL, worker_started_at=NULL, current_run_id=NULL, consecutive_failures=0, last_failure_error=NULL WHERE id=? AND status='blocked' AND current_run_id IS NULL")
                                    next-status task_id)]
                  (when-not (= 1 (.-changes updated)) (throw (ex-info "task changed before unblock" {})))
                  (.run (.prepare db "INSERT INTO task_events (task_id, kind, payload, created_at) VALUES (?, 'unblocked', ?, ?)")
                        task_id (when (or (not= next-status "ready") (not= resume "ready"))
                                  (h/json-str {"status" next-status "resume_status" resume})) now)
                  (.exec db "COMMIT")
                  (ok {"task_id" task_id "status" next-status})))
              (catch :default e
                (try (.exec db "ROLLBACK") (catch :default _ nil))
                (err (str "kanban_unblock: " (.-message e))))
              (finally (.close db)))))))))

(defn kanban-attachments
  "List task attachment metadata from the shared Kanban database."
  [ctx {:strs [task_id] :as args}]
  (cond
    (:peer? ctx) (err "kanban_attachments is unavailable in peer runs; Kanban state is host-local")
    (or (not (string? task_id)) (str/blank? task_id)) (err "kanban_attachments requires task_id")
    :else
    (let [db-path (kanban-db-path ctx args)]
      (cond
        (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
        (h/symlink? db-path) (err "Kanban database path must not be a symlink")
        :else
        (let [db (sqlite/DatabaseSync. db-path)]
          (try
            (let [task (.get (.prepare db "SELECT 1 AS present FROM tasks WHERE id = ?") task_id)]
              (when-not task (throw (ex-info (str "Kanban task not found: " task_id) {})))
              (let [attachments (sqlite-records db "SELECT id, filename, content_type, size, uploaded_by, stored_path, created_at FROM task_attachments WHERE task_id = ? ORDER BY created_at, id" task_id)]
                (ok {"task_id" task_id "attachments" attachments})))
            (catch :default e (err (str "kanban_attachments: " (.-message e))))
            (finally (.close db))))))))

(defn- kanban-attachments-root [ctx args]
  (if-let [override (not-empty (kanban-env ctx "HERMES_KANBAN_ATTACHMENTS_ROOT"))]
    (h/expand override)
    (let [root (kanban-root ctx)
          explicit (get args "board")
          env-board (kanban-env ctx "HERMES_KANBAN_BOARD")
          current-file (h/join root "kanban" "current")
          current (when (h/file? current-file) (str/trim (h/slurp current-file)))
          board (cond
                  (some? explicit) explicit
                  (not (str/blank? (str env-board))) env-board
                  (kanban-board-slug? current) current
                  :else "default")]
      (when-not (kanban-board-slug? board)
        (throw (ex-info "invalid Kanban board slug" {:board board})))
      (if (= board "default")
        (h/join root "kanban" "attachments")
        (h/join root "kanban" "boards" board "attachments")))))

(defn kanban-attach
  "Persist an inline attachment with the shared task-attachment metadata row."
  [ctx {:strs [task_id filename content_base64 content_type] :as args}]
  (cond
    (:peer? ctx) (err "kanban_attach is unavailable in peer runs; Kanban state is host-local")
    (or (not (string? task_id)) (not (re-matches #"^[A-Za-z0-9_-]{1,128}$" task_id))) (err "task_id is required and must be a valid task id")
    (or (not (string? filename)) (str/blank? filename)) (err "filename is required")
    (or (not (string? content_base64)) (str/blank? content_base64)) (err "content_base64 is required")
    (and (some? content_type) (not (string? content_type))) (err "content_type must be a string")
    (> (count content_base64) 34952536) (err "attachment exceeds 25 MB limit")
    (not (re-matches #"(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?" content_base64))
    (err "content_base64 is not valid base64")
    :else
    (let [db-path (kanban-db-path ctx args)
          root (kanban-attachments-root ctx args)
          name (-> filename (str/replace "\\" "/") (str/split #"/") last str/trim
                   (str/replace #"[\u0000-\u001F\u007F]" ""))
          name (loop [n name] (if (str/starts-with? n ".") (recur (subs n 1)) n))
          name (subs name 0 (min 200 (count name)))
          bytes (.from js/Buffer content_base64 "base64")]
      (cond
        (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
        (h/symlink? db-path) (err "Kanban database path must not be a symlink")
        (zero? (count name)) (err "invalid attachment filename")
        (> (.-length bytes) (* 25 1024 1024)) (err "attachment exceeds 25 MB limit")
        :else
        (let [task-dir (h/join root task_id)
              _ (when (h/symlink? root) (throw (ex-info "attachment root must not be a symlink" {})))
              _ (h/mkdirs task-dir)]
          (if (h/symlink? task-dir)
            (err "task attachment directory must not be a symlink")
            (let [dot (.lastIndexOf name ".")
                  stem (if (pos? dot) (subs name 0 dot) name)
                  ext (if (pos? dot) (subs name dot) "")
                  stored-name (loop [i 0]
                                (let [candidate (if (zero? i) name (str stem " (" i ")" ext))]
                                  (if (h/exists? (h/join task-dir candidate)) (recur (inc i)) candidate)))
                  stored-path (h/join task-dir stored-name)
                  db (sqlite/DatabaseSync. db-path)
                  timestamp (js/Math.floor (/ (h/now-ms) 1000))]
              (try
                (when-not (.get (.prepare db "SELECT 1 AS present FROM tasks WHERE id = ?") task_id)
                  (throw (ex-info (str "Kanban task not found: " task_id) {})))
                (h/spit-base64 stored-path content_base64 nil)
                (.exec db "BEGIN IMMEDIATE")
                (let [row (.run (.prepare db "INSERT INTO task_attachments (task_id, filename, stored_path, content_type, size, uploaded_by, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)")
                                task_id stored-name stored-path content_type (.-length bytes) "agent" timestamp)
                      id (.-lastInsertRowid row)]
                  (.run (.prepare db "INSERT INTO task_events (task_id, kind, payload, created_at) VALUES (?, 'attached', ?, ?)")
                        task_id (h/json-str {"filename" stored-name "size" (.-length bytes) "by" "agent"}) timestamp)
                  (.exec db "COMMIT")
                  (ok {"task_id" task_id "attachment_id" id "size" (.-length bytes)}))
                (catch :default e
                  (try (.exec db "ROLLBACK") (catch :default _ nil))
                  (h/rm stored-path)
                  (err (str "kanban_attach: " (.-message e))))
                (finally (.close db))))))))))

(defn kanban-attach-url
  "Fetch a public URL with SSRF-safe redirects and store it as an attachment."
  [ctx {:strs [task_id url filename content_type] :as args}]
  (let [task-id (or (not-empty task_id) (not-empty (kanban-env ctx "HERMES_KANBAN_TASK")))]
    (cond
      (:peer? ctx) (p/resolved (err "kanban_attach_url is unavailable in peer runs; Kanban state is host-local"))
      (not task-id) (p/resolved (err "kanban_attach_url requires task_id outside a dispatcher task"))
      (or (not (string? url)) (str/blank? url)) (p/resolved (err "url is required"))
      (and (some? filename) (not (string? filename))) (p/resolved (err "filename must be a string"))
      (and (some? content_type) (not (string? content_type))) (p/resolved (err "content_type must be a string"))
      :else
      (-> (webguard/fetch-bytes (str/trim url) {:max-bytes (* 25 1024 1024)})
          (p/then
           (fn [download]
             (cond
               (:truncated? download) (err "kanban_attach_url: attachment exceeds 25 MB limit")
               (not (<= 200 (:status download) 299)) (err (str "kanban_attach_url: HTTP " (:status download)))
               :else
               (let [bytes (:bytes download)
                     remote-type (:content-type download)
                     leaf (try
                            (let [parsed (js/URL. url)
                                  part (last (str/split (.-pathname parsed) #"/"))]
                              (js/decodeURIComponent part))
                            (catch :default _ "download"))
                     chosen (or (not-empty (some-> filename str/trim)) (not-empty leaf) "download")
                     media-type (or content_type
                                    (some-> remote-type (str/split #";") first str/trim not-empty))]
                 (kanban-attach ctx {"task_id" task-id "filename" chosen
                                     "content_base64" (.toString bytes "base64")
                                     "content_type" media-type "board" (get args "board")})))))
          (p/catch (fn [e] (err (str "kanban_attach_url: " (.-message e)))))))))

(defn kanban-comment
  "Append a comment and its matching task event to the shared Hermes Kanban DB."
  [ctx {:strs [task_id body] :as args}]
  (cond
    (:peer? ctx) (err "kanban_comment is unavailable in peer runs; Kanban state is host-local")
    (not (and (string? task_id) (not (str/blank? task_id)))) (err "kanban_comment requires task_id")
    (not (and (string? body) (not (str/blank? body)))) (err "kanban_comment requires non-empty body")
    :else
    (let [db-path (kanban-db-path ctx args)
          author (or (not-empty (:profile ctx)) "worker")]
      (cond
        (not (h/file? db-path)) (err (str "Kanban database not found: " db-path))
        (h/symlink? db-path) (err "Kanban database path must not be a symlink")
        :else
        (let [db (sqlite/DatabaseSync. db-path)]
          (try
            (.exec db "BEGIN IMMEDIATE")
            (let [task (.get (.prepare db "SELECT 1 AS present FROM tasks WHERE id = ?") task_id)]
              (when-not task (throw (ex-info (str "Kanban task not found: " task_id) {})))
              (let [timestamp (js/Math.floor (/ (h/now-ms) 1000))
                    clean-body (redact-kanban-comment body)
                    comment (.run (.prepare db "INSERT INTO task_comments (task_id, author, body, created_at) VALUES (?, ?, ?, ?)")
                                  task_id author clean-body timestamp)
                    payload (h/json-str {"author" author "len" (count clean-body)})]
                (.run (.prepare db "INSERT INTO task_events (task_id, kind, payload, created_at) VALUES (?, ?, ?, ?)")
                      task_id "commented" payload timestamp)
                (.exec db "COMMIT")
                (ok {"task_id" task_id "comment_id" (.-lastInsertRowid comment)})))
            (catch :default e
              (try (.exec db "ROLLBACK") (catch :default _ nil))
              (err (str "kanban_comment: " (.-message e))))
            (finally (.close db))))))))

(defn execute-code
  "Run one Python source string on stdin under the same OS confinement,
  sanitized environment, and write-root policy as terminal. Hermes' persistent
  kernel and in-script `hermes_tools` RPC are not emulated here."
  [ctx {:strs [code timeout]}]
  (cond
    (not (and (string? code) (not (str/blank? code))))
    (err "execute_code requires non-empty Python source in `code`")

    (and (:roots ctx) (not (writable? ctx (:cwd ctx))))
    (err (str "execute_code refused: workdir outside this run's roots: " (:cwd ctx)))

    :else
    (let [pol (policy ctx)
          c (confine/command pol {:argv ["python3" "-"]
                                  :write-roots (or (:roots ctx) [(:cwd ctx)])
                                  :read-roots (read-roots ctx)
                                  :tool-env (:tool-env ctx)
                                  :home (host-home ctx)
                                  :backend (backend ctx)})]
      (if-let [why (:refused c)]
        (err (str "execute_code refused: " why))
        (let [timeout-s (if (number? timeout) (max 1 (min 300 timeout)) 300)
              r (try (h/run-process (:argv c) {:cwd (:cwd ctx) :exact-env? true :env (:env c)
                                               :input code :timeout-ms (* 1000 timeout-s)})
                     (finally (when (:tmpdir c) (h/rm (:tmpdir c)))))
              output (str (:stdout r) (when-not (str/blank? (:stderr r))
                                        (str "\n[stderr]\n" (:stderr r))))]
          (confine/audit! {:tool "execute_code" :profile (:profile ctx) :peer? (:peer? pol)
                           :sandbox (:sandbox c) :cmd "python3 -" :exit (:exit r)
                           :stderr (:stderr r) :timed-out? (:timed-out? r)})
          (ok {"output" (clip output 50000)
               "exit_code" (:exit r)
               "sandbox" (name (:sandbox c))
               "error" (when (:timed-out? r) "timeout")
               "persistent" false
               "tool_rpc" false}))))))

(def impls
  {"terminal" terminal "process_manage" process/manage "read_file" read-file "write_file" write-file "patch" patch
   "search_files" search-files "web_extract" web-extract "web_search" web-search
   "browser_navigate" browser/navigate "browser_snapshot" browser/snapshot
   "browser_click" browser/click "browser_type" browser/type-text
   "browser_scroll" browser/scroll "browser_back" browser/back
   "browser_press" browser/press "browser_get_images" browser/get-images
   "browser_console" browser/console-output
   "browser_vision" browser-vision
   "vision_analyze" vision-analyze
   "computer_use" computer-use/call
   "skills_list" skills-list "skill_view" skill-view "skill_manage" skill-manage
   "todo_list" todo-list "memory" memory "execute_code" execute-code
   "session_search" session-search "kanban_show" kanban-show "kanban_list" kanban-list
   "kanban_heartbeat" kanban-heartbeat
   "kanban_complete" kanban-complete
   "kanban_block" kanban-block
   "kanban_request_review" kanban-request-review
   "kanban_request_changes" kanban-request-changes
   "kanban_link" kanban-link
   "kanban_unblock" kanban-unblock
   "kanban_create" kanban-create
   "kanban_attachments" kanban-attachments
   "kanban_attach" kanban-attach
   "kanban_attach_url" kanban-attach-url
   "kanban_comment" kanban-comment
   "ha_list_entities" (ha-tool "ha_list_entities")
   "ha_get_state" (ha-tool "ha_get_state")
   "ha_list_services" (ha-tool "ha_list_services")
   "ha_call_service" (ha-tool "ha_call_service")})

(defn call
  "Run one tool call. Text tools return strings; tools may return the reserved
  $kotoba_tool_text / $kotoba_tool_images envelope for multimodal output."
  [ctx allowed name args-json]
  (let [args (try (if (string? args-json) (h/json-parse (if (str/blank? args-json) "{}" args-json)) args-json)
                  (catch :default _ ::bad))]
    (cond
      (= args ::bad) (p/resolved (err (str "invalid JSON arguments for " name)))
      (not (some #{name} allowed)) (p/resolved (err (str "tool not available in this run: " name)))
      :else (if-let [f (or (get impls name) (get (:tool-overrides ctx) name))]
              (-> (p/do (f ctx args))
                  (p/catch (fn [e] (err (str name ": " (.-message e))))))
              (p/resolved (err (str "tool executor not configured for " name)))))))

(defn tool-result-text [result]
  "Compact text for logs and budget notices; never include base64 image payloads."
  (if (and (map? result) (contains? result "$kotoba_tool_text"))
    (get result "$kotoba_tool_text")
    (if (string? result) result (h/json-str result))))

(defn tool-result-images [result]
  "Images produced by a tool, encoded as user-message image_url parts."
  (if (and (map? result) (vector? (get result "$kotoba_tool_images")))
    (get result "$kotoba_tool_images")
    []))
