(ns itonami.agent.loop
  "The turn loop: system prompt assembly and model -> tools -> model until the
  model answers without tool calls, max_turns is reached or the run budget
  runs out. Semantics follow Hermes agent/conversation_loop.py (the parity
  target kotoba-lang/agent turn_loop.kotoba was transcribed from):

    - iterate while api_call_count < max_turns
    - at 80% of agent.run_budget_seconds, append the wrap-up notice to the
      newest tool result so the model finishes instead of being cut off
    - exit reasons: completed | max_iterations_reached(N/N) | budget_exhausted | provider_error"
  (:require [clojure.string :as str]
            [promesa.core :as p]
            [itonami.agent.host :as h]
            [itonami.agent.provider :as provider]
            [itonami.agent.browser :as browser-runtime]
            [itonami.agent.computer-use :as computer-use]
            [itonami.agent.tools :as tools]
            [itonami.agent.mcp :as mcp]
            [itonami.agent.yaml :as yaml]
            [itonami.agent.confine :as confine]))

(def wrapup-notice
  "\n\n[RUN BUDGET] You have used most of this run's time budget. Stop starting new work: finish the current step and give your final answer now.")

(def guidance
  "## Finishing the job
Work until the task is done, then answer with a short report: what changed, what is verified, what is left. If you could not measure something, say UNMEASURED instead of guessing.

## Tool use
Use tools to act; do not describe a tool call instead of making it. Independent tool calls may be made in one turn.")

(defn- skills-index [home]
  (let [root (h/join home "skills")
        files (if (h/dir? root) (h/walk-files root (fn [_] false)) [])
        entries (keep (fn [rel]
                        (let [parts (str/split rel #"/")
                              skill-path (vec (butlast parts))]
                          (when (and (= "SKILL.md" (last parts)) (#{1 2} (count skill-path)))
                            (let [f (h/join root rel)
                                  content (h/slurp f)
                                  frontmatter (second (re-find #"(?s)^---\s*\n(.*?)\n---(?:\n|$)" content))
                                  meta (when frontmatter
                                         (try (yaml/parse frontmatter) (catch :default _ nil)))]
                              (when (map? meta)
                                {:category (when (= 2 (count skill-path)) (first skill-path))
                                 :name (last skill-path)
                                 :description (get meta "description" "")}))))) files)]
    (when (seq entries)
      (str "## Skills\n<available_skills>\n"
           (str/join "\n" (for [[cat grp] (sort-by (comp str key) (group-by :category entries))]
                            (str (when cat (str "category: " cat "\n"))
                                 (str/join "\n" (for [{:keys [name description]} (sort-by :name grp)]
                                                    (str "- " name ": " description))))))
           "\n</available_skills>\nLoad one with skill_view(name) before following it."))))

(defn- context-file
  "First match wins, like Hermes: .hermes.md / HERMES.md, else AGENTS.md,
  else CLAUDE.md, looked up from cwd towards /."
  [cwd]
  (loop [d cwd]
    (when (and d (not= d (h/dirname d)))
      (if-let [f (first (filter h/file? (map #(h/join d %) [".hermes.md" "HERMES.md" "AGENTS.md" "CLAUDE.md"])))]
        (let [t (h/slurp f)] (str "# Project context (" f ")\n" (subs t 0 (min 20000 (count t)))))
        (recur (h/dirname d))))))

(defn history-messages
  "Normalize prior user/assistant messages for a new agent turn. System/developer
  instructions are supplied separately; tool messages belong to the previous
  turn and are intentionally omitted from the desktop-compatible history."
  [history]
  (vec (for [m (or history [])
             :let [role (or (get m "role") (:role m))
                   content (or (get m "content") (:content m))]
             :when (contains? #{"user" "assistant"} role)]
         {"role" role
          "content" (cond
                      (string? content) content
                      (sequential? content)
                      (str/join "\n" (keep (fn [part]
                                                (when (or (= "text" (get part "type"))
                                                          (= "text" (:type part)))
                                                  (or (get part "text") (:text part) "")))
                                              content))
                      (nil? content) ""
                      :else (str content))})))

(defn system-prompt
  "skills? false leaves out the skills index: listing skills to a run that has
  no skill_view tool only costs tokens (on a busy rail, minutes per turn)."
  [{:keys [soul home]} {:keys [cwd platform load-context? skills? instructions]
                        :or {skills? true}}]
  (str/join "\n\n"
            (remove str/blank?
                    [(or soul "You are a helpful agent running on the itonami plane.")
                     (when-not (str/blank? instructions)
                       (str "# Session instructions\n" instructions))
                     guidance
                     (when skills? (skills-index home))
                     (when load-context? (context-file cwd))
                     (str "# Runtime environment\n"
                          "- engine: itonami-agent (kotoba, Hermes-compatible)\n"
                          "- platform: " (or platform "cli") "\n"
                          "- profile home: " home "\n"
                          "- cwd: " cwd "\n"
                          "- time: " (h/iso-local))])))

(declare run delegated-tasks)

(defn run
  "One conversation. Resolves to
   {:final str :exit-reason str :turns n :messages [...] :usage {...}
    :provider str :model str :attempts [...] :writes [abs-paths]}"
  [{:keys [config env] :as prof} prompt {:keys [model provider pinned? toolsets tool-names cwd roots platform
                                                load-context? max-turns budget-s on-event peer?
                                                reasoning-effort max-tokens
                                                history instructions before-tool tool-overrides]
                                         :as options}]
  (let [max-turns (or max-turns (get-in config ["agent" "max_turns"]) (get config "max_turns") 90)
        budget-ms (* 1000 (or budget-s (get-in config ["agent" "run_budget_seconds"]) 0))
        hops (provider/decentralize (provider/chain config {:model model :provider provider :pinned? pinned?})
                                    (:itonami prof) config)
        requested-sets (when (nil? tool-names) (or toolsets ["hermes-cli"]))
        disabled (tools/execution-disabled-toolsets config platform)
        all-requested (or tool-names requested-sets)
        mcp-servers (if (and requested-sets (not peer?)) (mcp/names-for config requested-sets disabled) [])
        unknown-sets (tools/unsupported-toolsets requested-sets (set (keys (get config "mcp_servers" {}))))
        _ (when (seq unknown-sets)
            (throw (ex-info (str "Kotoba agent does not recognize Hermes toolsets: "
                                 (str/join ", " unknown-sets))
                            {:unsupported-toolsets unknown-sets})))
        ;; agent.disabled_toolsets travels in the bundle (not host-local), so a
        ;; peer turn drops the same tools; a -t / peer opts toolsets cannot re-add them
        browser-cdp-configured? (or (not (str/blank? (get env "BROWSER_CDP_URL")))
                                    (not (str/blank? (get-in config ["browser" "cdp_url"])))
                                    (not (str/blank? (get-in config ["browser" "cdp_endpoint"]))))
        names (tools/runtime-tool-names all-requested disabled browser-cdp-configured?
                                         (browser-runtime/cli-available?)
                                         (computer-use/cli-available? env))
        mcp-data (mcp/discover config env mcp-servers (:home prof))
        mcp-index (:index mcp-data)
        mcp-names (vec (keys mcp-index))
        names (into names mcp-names)
        unsupported (tools/unsupported-tools (remove (set mcp-names) names))
        _ (when (seq unsupported)
            (throw (ex-info (str "Kotoba agent cannot run this Hermes toolset yet; unsupported tools: "
                                 (str/join ", " unsupported))
                            {:unsupported-tools unsupported})))
        schemas (into (tools/tool-schemas names)
                      (:schemas mcp-data))
        mcp-overrides (into {} (for [[wire [server raw]] mcp-index]
                                 [wire (fn [_ args] (mcp/call config env server raw args (:home prof)))]))
        writes (atom [])
        todo-state (tools/todo-history-state history)
        cwd (or cwd (some-> (get-in config ["terminal" "cwd"]) h/expand) (h/join (:home prof) "workspace"))
        _ (h/mkdirs cwd)
        ctx {:cwd cwd :home (:home prof) :profile (:name prof) :roots roots :writes writes :tool-env env
             :browser-config (get config "browser" {})
             :browser-session (str "kotoba-" (h/random-hex 12))
             :browser-used? (atom false)
             :computer-config (get config "computer_use" {})
             :computer-session (str "kotoba-" (h/random-hex 12))
             :computer-state (atom {})
             :approval-available? (boolean before-tool)
             :model-hops hops :reasoning-effort reasoning-effort
             :todos (atom (:todos todo-state)) :todo-revision (atom (:revision todo-state))
             :mcp-config config :mcp-index mcp-index
             :tool-overrides (merge mcp-overrides tool-overrides)
             :peer? peer?
             :terminal-policy (confine/policy (:itonami prof) {:peer? peer?})}
        t0 (h/now-ms)
        emit (or on-event (fn [_]))
        mcp-notice (cond
                     peer? "\n\n## MCP tools unavailable\nCustom MCP servers are disabled for peer runs. Do not claim that you used them."
                     (seq (:errors mcp-data))
                     (str "\n\n## MCP server issues\n"
                          (str/join "\n" (map (fn [e] (str "- " (get e "server") ": " (get e "error")))
                                       (:errors mcp-data)))
                          "\nThese tools are unavailable in this run; do not claim that you used them.")
                     :else nil)
        usage (atom {"prompt_tokens" 0 "completion_tokens" 0 "total_tokens" 0})
        add-usage! (fn [u] (when u (swap! usage #(merge-with + % (select-keys u ["prompt_tokens" "completion_tokens" "total_tokens"])))))]
      (p/finally
       (p/loop [messages (into [{"role" "system" "content"
                                (str (system-prompt prof {:cwd cwd :platform platform
                                                          :load-context? load-context?
                                                          :skills? (boolean (some #{"skill_view"} names))
                                                          :instructions instructions})
                                     (or mcp-notice ""))}]
                              (concat (history-messages history)
                                      [{"role" "user" "content" prompt}]))
             n 0
             attempts []
             last-hop nil]
      (cond
        (>= n max-turns)
        {:final nil :exit-reason (str "max_iterations_reached(" n "/" max-turns ")") :turns n
         :messages messages :usage @usage :attempts attempts :writes @writes
         :provider (:provider last-hop) :model (:model last-hop)}

        (and (pos? budget-ms) (> (- (h/now-ms) t0) budget-ms))
        {:final nil :exit-reason "budget_exhausted" :turns n :messages messages :usage @usage
         :attempts attempts :writes @writes :provider (:provider last-hop) :model (:model last-hop)}

        :else
        (p/let [r (provider/complete hops env {:messages messages :tools schemas
                                               :reasoning-effort (or reasoning-effort
                                                                     (get-in config ["agent" "reasoning_effort"]))
                                               :max-tokens (or max-tokens
                                                               (get-in config ["model" "max_tokens"]))
                                               :deadline-ms (when (pos? budget-ms) (+ t0 budget-ms))
                                               :on-hop (fn [hop r ms]
                                                         (emit {:event :hop :provider (:provider hop) :model (:model hop)
                                                                :ms ms :ok (boolean (:ok r))
                                                                :error (get-in r [:err :error])}))})]
          (let [attempts (into attempts (:attempts r))]
            (if-let [err (:err r)]
              {:final nil :exit-reason "provider_error" :error err :turns n :messages messages
               :usage @usage :attempts attempts :writes @writes}
              (let [{:keys [message] :as resp} (:ok r)
                    _ (add-usage! (:usage resp))
                    calls (get message "tool_calls")
                    assistant (cond-> {"role" "assistant" "content" (get message "content")}
                                (seq calls) (assoc "tool_calls" calls))
                    messages (conj messages assistant)]
                (emit {:event :assistant :turn (inc n) :provider (:provider resp) :model (:model resp)
                       :content (get message "content") :tool-calls (count calls)})
                (if (empty? calls)
                  {:final (or (get message "content") "") :exit-reason "completed" :turns (inc n)
                   :messages messages :usage @usage :attempts attempts :writes @writes
                   :provider (:provider resp) :model (:model resp)}
                  (p/let [images (atom [])
                          results (p/loop [[c & more] calls acc []]
                                    (if (nil? c)
                                      acc
                                      (p/let [nm (get-in c ["function" "name"])
                                              args (get-in c ["function" "arguments"])
                                              args-map (try (if (string? args) (h/json-parse (if (str/blank? args) "{}" args)) args)
                                                            (catch :default _ nil))
                                              approved? (if (and before-tool (tools/approval-required? nm args-map))
                                                          (before-tool {:id (get c "id") :name nm :arguments args})
                                                          true)
                                              t1 (h/now-ms)
                                              _ (emit {:event :tool-start :name nm
                                                       :args (if (or (some #{nm} tools/browser-tools)
                                                                     (= nm "computer_use"))
                                                               "[sensitive UI arguments redacted]"
                                                               (subs (str args) 0 (min 160 (count (str args)))))})
                                              out-result (if approved?
                                                    (if (= nm "delegate_task")
                                                      (if (map? args-map)
                                                        (delegated-tasks prof names options args-map)
                                                        (h/json-str {"error" "delegate_task arguments must be a JSON object"}))
                                                      (tools/call (assoc ctx :tool-approved? approved?) names nm args))
                                                    (h/json-str {"error" "Tool call denied by user."}))
                                              out (tools/tool-result-text out-result)
                                              _ (swap! images into (tools/tool-result-images out-result))]
                                        (emit {:event :tool :name nm :bytes (count out)
                                               :ms (- (h/now-ms) t1) :denied (not approved?)})
                                        (p/recur more (conj acc {"role" "tool" "tool_call_id" (get c "id") "content" out})))))
                          results (if (and (pos? budget-ms) (> (- (h/now-ms) t0) (* 0.8 budget-ms)) (seq results))
                                    (update-in results [(dec (count results)) "content"] str wrapup-notice)
                                    results)]
                    (let [image-message (when (seq @images)
                                          {"role" "user"
                                           "content" (into [{"type" "text"
                                                             "text" "Image output from the preceding tool call(s):"}]
                                                           @images)})]
                      (p/recur (cond-> (into messages results) image-message (conj image-message))
                               (inc n) attempts resp))))))))))
       (fn [] (browser-runtime/close-session ctx)))))

(defn delegated-tasks
  "Run bounded foreground child turns in Kotoba with recursive delegation and
  persistent memory/cron tools removed. Each child receives only its own goal
  and explicit context, never the parent's transcript."
  [prof parent-names parent-options {:strs [tasks]}]
  (let [tasks (if (vector? tasks) tasks [])
        configured-max (get-in (:config prof) ["delegation" "max_concurrent_children"])
        max-children (if (and (number? configured-max) (pos? configured-max))
                       (min 3 (js/Math.floor configured-max))
                       3)]
    (cond
      (empty? tasks) (h/json-str {"error" "delegate_task requires at least one task"})
      (> (count tasks) max-children)
      (h/json-str {"error" (str "delegate_task accepts at most " max-children " tasks for this profile")})
      (some #(or (not (map? %)) (not (string? (get % "goal"))) (str/blank? (get % "goal"))) tasks)
      (h/json-str {"error" "each delegated task needs a non-empty goal"})
      :else
      (let [child-names (vec (remove #(or (#{"delegate_task" "memory" "cronjob_manage"} %)
                                             (str/starts-with? % "kanban_")) parent-names))
            configured-budget (:budget-s parent-options)
            budget-s (if (and (number? configured-budget) (pos? configured-budget))
                       (min 300 configured-budget)
                       300)
            child-runs (mapv (fn [task]
                               (let [raw-context (get task "context")
                                     context (when (string? raw-context)
                                               (subs raw-context 0 (min 20000 (count raw-context))))
                                     prompt (str "## Delegated goal\n" (get task "goal")
                                                 (when (and (string? context) (not (str/blank? context)))
                                                   (str "\n\n## Context\n" context))
                                                 "\n\nWork only on this delegated task. Do not delegate further.")
                                     child-options (assoc parent-options
                                                          :tool-names child-names
                                                          :toolsets nil
                                                          :history []
                                                          :instructions "You are a Kotoba child agent. Return a concise result for the parent task.")]
                                 (p/then (run prof prompt (assoc child-options :budget-s budget-s))
                                         (fn [result]
                                           {"goal" (get task "goal")
                                            "status" (:exit-reason result)
                                            "summary" (when-let [summary (:final result)]
                                                        (subs summary 0 (min 8000 (count summary))))
                                            "error" (get-in result [:error :error])}))))
                             tasks)]
        (p/then (p/all child-runs) (fn [results] (h/json-str {"results" (vec results)})))))))
